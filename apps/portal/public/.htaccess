# Espace client (www/espace/) : tout passe par index.php, sauf la feuille de style.
Options -Indexes
DirectoryIndex index.php

<IfModule mod_headers.c>
    Header always set X-Robots-Tag "noindex, nofollow, noarchive"
    Header always set Cache-Control "no-store"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "same-origin"
    # Aucun script, aucun style en ligne, rien de tiers.
    Header always set Content-Security-Policy "default-src 'none'; style-src 'self'; img-src 'self'; form-action 'self'; base-uri 'none'; frame-ancestors 'none'"
    <FilesMatch "\.css$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /espace/
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
