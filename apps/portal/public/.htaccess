# Espace client (www/espace/) : tout passe par index.php, sauf les fichiers statiques (portal.css, prefs.js, ui/).
Options -Indexes
DirectoryIndex index.php
# Type des polices (inconnu de l'hébergeur : sans lui, elles partent sans Content-Type)
AddType font/woff2 .woff2

# Le .htaccess du site (www/) active mod_expires pour les CSS : ici, seul le Cache-Control ci-dessous fait foi.
<IfModule mod_expires.c>
    ExpiresActive Off
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Robots-Tag "noindex, nofollow, noarchive"
    Header always set Cache-Control "no-store"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "same-origin"
    # Rien de tiers, aucun script ni style en ligne. Seul script : prefs.js (thème et curseur choisis sur le site).
    # img-src data: : images du curseur du site, intégrées dans ui/ui.css. font-src : polices du design system (ui/fonts/).
    Header always set Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; form-action 'self'; base-uri 'none'; frame-ancestors 'none'"
    # « always », comme la règle no-store ci-dessus : même table d'en-têtes, donc la valeur la remplace au lieu de s'y ajouter.
    <FilesMatch "\.(css|js)$">
        Header always set Cache-Control "no-cache"
    </FilesMatch>
    <FilesMatch "\.woff2$">
        Header always set Cache-Control "public, max-age=2592000"
    </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /espace/
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
