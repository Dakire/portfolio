{
  "name": "grichard/portal",
  "description": "Espace client de test de grichard.eu (Symfony 7.4 LTS, SQLite).",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.4",
    "ext-ctype": "*",
    "ext-iconv": "*",
    "ext-pdo_sqlite": "*",
    "doctrine/dbal": "^4.2",
    "doctrine/doctrine-bundle": "^3.0",
    "doctrine/doctrine-migrations-bundle": "^4.0",
    "doctrine/migrations": "^3.9",
    "doctrine/orm": "^3.5",
    "symfony/console": "7.4.*",
    "symfony/framework-bundle": "7.4.*",
    "symfony/monolog-bundle": "^4.0",
    "symfony/rate-limiter": "7.4.*",
    "symfony/security-bundle": "7.4.*",
    "symfony/security-csrf": "7.4.*",
    "symfony/twig-bundle": "7.4.*",
    "symfony/yaml": "7.4.*"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.95",
    "phpstan/phpstan": "^2.3",
    "phpstan/phpstan-doctrine": "^2.0",
    "phpstan/phpstan-symfony": "^2.0",
    "phpunit/phpunit": "^13.4",
    "symfony/browser-kit": "7.4.*",
    "symfony/css-selector": "7.4.*"
  },
  "autoload": {
    "psr-4": {
      "Grichard\\Portal\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Grichard\\Portal\\Tests\\": "tests/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": {
      "*": "dist"
    },
    "sort-packages": true,
    "allow-plugins": {}
  },
  "extra": {
    "symfony": {
      "allow-contrib": false,
      "require": "7.4.*"
    }
  },
  "scripts": {
    "test": "phpunit",
    "stan": "phpstan analyse --memory-limit=1G",
    "cs": "php-cs-fixer fix --dry-run --diff",
    "cs:fix": "php-cs-fixer fix"
  },
  "conflict": {
    "symfony/symfony": "*",
    "symfony/browser-kit": ">=7.5",
    "symfony/cache": ">=7.5",
    "symfony/clock": ">=7.5",
    "symfony/config": ">=7.5",
    "symfony/console": ">=7.5",
    "symfony/css-selector": ">=7.5",
    "symfony/dependency-injection": ">=7.5",
    "symfony/doctrine-bridge": ">=7.5",
    "symfony/dom-crawler": ">=7.5",
    "symfony/error-handler": ">=7.5",
    "symfony/event-dispatcher": ">=7.5",
    "symfony/filesystem": ">=7.5",
    "symfony/finder": ">=7.5",
    "symfony/framework-bundle": ">=7.5",
    "symfony/http-foundation": ">=7.5",
    "symfony/http-kernel": ">=7.5",
    "symfony/monolog-bridge": ">=7.5",
    "symfony/monolog-bundle": ">=7.5",
    "symfony/options-resolver": ">=7.5",
    "symfony/password-hasher": ">=7.5",
    "symfony/process": ">=7.5",
    "symfony/property-access": ">=7.5",
    "symfony/property-info": ">=7.5",
    "symfony/rate-limiter": ">=7.5",
    "symfony/routing": ">=7.5",
    "symfony/security-bundle": ">=7.5",
    "symfony/security-core": ">=7.5",
    "symfony/security-csrf": ">=7.5",
    "symfony/security-http": ">=7.5",
    "symfony/stopwatch": ">=7.5",
    "symfony/string": ">=7.5",
    "symfony/twig-bridge": ">=7.5",
    "symfony/twig-bundle": ">=7.5",
    "symfony/type-info": ">=7.5",
    "symfony/var-dumper": ">=7.5",
    "symfony/var-exporter": ">=7.5",
    "symfony/yaml": ">=7.5"
  }
}
