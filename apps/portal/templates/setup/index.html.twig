{% extends 'base.html.twig' %}
{% block title %}Installation{% endblock %}
{% block body %}
  <h1>Installation</h1>
  <p>Crée la base de données et le premier administrateur. Cette page disparaît dès qu'un utilisateur existe.</p>
  {% if error %}<p class="error" role="alert">{{ error }}</p>{% endif %}
  <form method="post" class="stack">
    <label for="setup_token">Jeton d'installation</label>
    <input id="setup_token" name="setup_token" type="password" autocomplete="off" required>
    <label for="email">Adresse e-mail de l'administrateur</label>
    <input id="email" name="email" type="email" value="{{ email }}" autocomplete="username" required>
    <label for="password">Mot de passe ({{ min_length }} caractères minimum)</label>
    <input id="password" name="password" type="password" minlength="{{ min_length }}" autocomplete="new-password" required>
    <label for="password_confirm">Confirmer le mot de passe</label>
    <input id="password_confirm" name="password_confirm" type="password" autocomplete="new-password" required>
    <input type="hidden" name="_token" value="{{ csrf_token('setup') }}">
    <button type="submit">Installer</button>
  </form>
{% endblock %}
