{% extends 'base.html.twig' %}
{% block title %}Installation{% endblock %}
{% block body %}
  <div class="portal-narrow">
    <div class="portal-head">
      <p class="rule-label">première mise en service</p>
      <h1>Installation</h1>
      <p class="portal-lede">Crée la base de données et le premier administrateur. Cette page disparaît dès qu'un utilisateur existe.</p>
    </div>
    {% if error %}
      <div class="alert alert-danger" role="alert">
        <p class="alert-title">Installation impossible</p>
        <p>{{ error }}</p>
      </div>
    {% endif %}
    <form method="post" class="portal-form">
      <div class="field">
        <label for="setup_token">Jeton d'installation</label>
        <input id="setup_token" name="setup_token" type="password" autocomplete="off" required>
      </div>
      <div class="field">
        <label for="email">Adresse e-mail de l'administrateur</label>
        <input id="email" name="email" type="email" value="{{ email }}" autocomplete="username" required>
      </div>
      <div class="field">
        <label for="password">Mot de passe</label>
        <input id="password" name="password" type="password" minlength="{{ min_length }}" autocomplete="new-password" aria-describedby="password-hint" required>
        <p class="field-hint" id="password-hint">{{ min_length }} caractères minimum.</p>
      </div>
      <div class="field">
        <label for="password_confirm">Confirmer le mot de passe</label>
        <input id="password_confirm" name="password_confirm" type="password" autocomplete="new-password" required>
      </div>
      <input type="hidden" name="_token" value="{{ csrf_token('setup') }}">
      <button type="submit" class="btn btn-primary">Installer</button>
    </form>
  </div>
{% endblock %}
