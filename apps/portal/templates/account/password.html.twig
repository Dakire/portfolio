{% extends 'base.html.twig' %}
{% block title %}Changer de mot de passe{% endblock %}
{% block body %}
  <div class="portal-narrow">
    <div class="portal-head">
      <p class="rule-label">compte</p>
      <h1>Changer de mot de passe</h1>
    </div>
    {% if error %}
      <div class="alert alert-danger" role="alert">
        <p class="alert-title">Mot de passe refusé</p>
        <p>{{ error }}</p>
      </div>
    {% endif %}
    <form method="post" class="portal-form">
      <div class="field">
        <label for="current_password">Mot de passe actuel</label>
        <input id="current_password" name="current_password" type="password" autocomplete="current-password" required>
      </div>
      <div class="field">
        <label for="password">Nouveau mot de passe</label>
        <input id="password" name="password" type="password" minlength="{{ min_length }}" autocomplete="new-password" aria-describedby="password-hint" required>
        <p class="field-hint" id="password-hint">{{ min_length }} caractères minimum.</p>
      </div>
      <div class="field">
        <label for="password_confirm">Confirmer le nouveau mot de passe</label>
        <input id="password_confirm" name="password_confirm" type="password" autocomplete="new-password" required>
      </div>
      <input type="hidden" name="_token" value="{{ csrf_token('account_password') }}">
      <button type="submit" class="btn btn-primary">Enregistrer</button>
    </form>
    <ul class="portal-links" role="list"><li><a href="{{ path('app_account') }}">Retour au compte</a></li></ul>
  </div>
{% endblock %}
