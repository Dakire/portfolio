{% extends 'base.html.twig' %}
{% block title %}Mot de passe oublié{% endblock %}
{% block body %}
  <div class="portal-narrow">
    <div class="portal-head">
      <p class="rule-label">espace client</p>
      <h1>Mot de passe oublié</h1>
      <p class="portal-lede">Indiquez l'adresse de votre compte : un lien pour choisir un nouveau mot de passe vous sera envoyé.</p>
    </div>
    <form method="post" class="portal-form">
      <div class="field">
        <label for="email">Adresse e-mail du compte</label>
        <input id="email" name="email" type="email" autocomplete="email" required>
      </div>
      <input type="hidden" name="_token" value="{{ csrf_token('forgot') }}">
      <button type="submit" class="btn btn-primary">Envoyer le lien</button>
    </form>
    <ul class="portal-links" role="list">
      <li><a href="{{ path('app_login') }}">Retour à la connexion</a></li>
    </ul>
  </div>
{% endblock %}
