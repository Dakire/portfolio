{% extends 'base.html.twig' %}
{% block title %}Connexion{% endblock %}
{% block body %}
  <h1>Connexion</h1>
  {% if error %}<p class="error" role="alert">Identifiants incorrects, ou trop d'essais récents. Réessayez dans quelques minutes.</p>{% endif %}
  <form method="post" class="stack">
    <label for="username">Adresse e-mail</label>
    <input id="username" name="_username" type="email" value="{{ last_username }}" autocomplete="username" required autofocus>
    <label for="password">Mot de passe</label>
    <input id="password" name="_password" type="password" autocomplete="current-password" required>
    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
    <button type="submit">Se connecter</button>
  </form>
{% endblock %}
