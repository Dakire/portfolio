{% extends 'base.html.twig' %}
{% block title %}Accueil{% endblock %}
{% block body %}
  <div class="portal-head">
    <p class="rule-label">espace client</p>
    <h1>Bonjour</h1>
  </div>
  <section class="stack" aria-labelledby="compte">
    <div class="rubric"><h2 id="compte">Votre compte</h2></div>
    <dl class="kv">
      <dt>Compte</dt><dd>{{ user.email }}</dd>
      <dt>Rôles</dt><dd>{{ user.roles|join(', ') }}</dd>
      <dt>Dernière connexion</dt><dd>{{ user.lastLoginAt ? user.lastLoginAt|date('d/m/Y H:i') : 'première connexion' }}</dd>
    </dl>
  </section>
  <p class="portal-lede">Les commandes, licences et téléchargements arriveront ici à l'ouverture de la <a href="{{ path('app_shop') }}">boutique</a>.</p>
{% endblock %}
