{% extends 'base.html.twig' %}
{% block title %}Maintenance{% endblock %}
{% block body %}
  <div class="portal-head">
    <p class="rule-label">administration</p>
    <h1>Maintenance</h1>
  </div>
  <dl class="kv">
    <dt>Version de la base</dt><dd><code>{{ current }}</code></dd>
  </dl>
  {% if pending is empty %}
    <div class="alert alert-ok" role="status">
      <p class="alert-title">À jour</p>
      <p>La base est à jour.</p>
    </div>
  {% else %}
    <div class="alert alert-warn" role="status">
      <p class="alert-title">Migrations en attente</p>
      <p>{{ pending|length }} migration(s) en attente :</p>
      <ul>{% for version in pending %}<li><code>{{ version }}</code></li>{% endfor %}</ul>
    </div>
    <form method="post">
      <input type="hidden" name="_token" value="{{ csrf_token('maintenance') }}">
      <button type="submit" class="btn btn-primary">Appliquer les migrations</button>
    </form>
  {% endif %}
{% endblock %}
