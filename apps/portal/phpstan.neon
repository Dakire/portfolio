includes:
    - vendor/phpstan/phpstan-symfony/extension.neon
    - vendor/phpstan/phpstan-doctrine/extension.neon

parameters:
    level: 8
    paths:
        - src
        - public
        - tests
        - migrations
    excludePaths:
        - var (?)
    # Vérificateur de licence embarqué dans les modules PrestaShop (sans autoload), chargé par tests/LicenceInteropTest.php
    scanFiles:
        - ../../packages/licence/php/GrichardLicence.php
