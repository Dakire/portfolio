{
  "prerender": [
    {
      "where": {
        "and": [
          { "href_matches": "/*" },
          {
            "not": {
              "href_matches": [
                "/*.php",
                "/*.php?*",
                "/*.pdf",
                "/*.xml",
                "/*.txt",
                "/*.json",
                "/*.ics",
                "/*.png",
                "/*.svg"
              ]
            }
          },
          {
            "not": {
              "selector_matches": "[target=_blank], [download], [rel~=nofollow], [data-no-prerender]"
            }
          }
        ]
      },
      "eagerness": "moderate"
    }
  ]
}
