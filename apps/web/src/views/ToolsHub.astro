---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { crumbs } from '../lib/crumbs';
import ToolCards from '../components/ToolCards.astro';
import '../styles/tools.css';
import { ROUTES, routeAlternates, type Lang } from '../lib/i18n';
import { HUB, TOOL_GROUPS } from '../tools/hub';
import { TOOLS, toolPath, toolUi } from '../tools/registry';
import { breadcrumbLd } from '../lib/seo';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const hub = HUB[lang];
const ld = {
  '@context': 'https://schema.org',
  '@graph': [
    breadcrumbLd([
      { name: hub.breadcrumb.home, path: ROUTES[lang].home },
      { name: hub.breadcrumb.tools, path: ROUTES[lang].tools },
    ]),
    {
      '@type': 'ItemList',
      name: hub.schemaName,
      itemListElement: TOOLS.map((tool, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        url: `https://grichard.eu${toolPath(tool, lang)}`,
        name: toolUi(tool, lang).name,
      })),
    },
  ],
};
---

<Base
  lang={lang}
  title={hub.meta.title}
  description={hub.meta.description}
  path={ROUTES[lang].tools}
  alternates={routeAlternates('tools')}
  ld={ld}
>
  <PageHero
    path="~/tools"
    title={hub.h1}
    lead={hub.intro}
    crumbs={crumbs(lang, [], { label: hub.h1, path: ROUTES[lang].tools })}
  />
  <div class="container tools-top">
    <nav class="tool-groups-nav" aria-label={hub.groupsLabel}>
      <ul role="list">
        {TOOL_GROUPS.map((group) => (
          <li>
            <a href={`#${group.id}`}>
              {group[lang].title}
              <span class="tool-groups-count">{group.tools.length}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
  {TOOL_GROUPS.map((group) => (
    <section class="tool-group" id={group.id} aria-labelledby={`${group.id}-title`}>
      <div class="container">
        <div class="rubric">
          <h2 id={`${group.id}-title`}>{group[lang].title}</h2>
          <p class="rubric-meta">
            {group.tools.length} {lang === 'fr' ? 'outils' : 'tools'}
          </p>
        </div>
        <p class="section-intro">{group[lang].text}</p>
        <ToolCards lang={lang} headingLevel={3} ids={group.tools} />
      </div>
    </section>
  ))}
  <div class="container section">
    <section class="tool-section tool-block" aria-labelledby="privacy-title">
      <h2 id="privacy-title">{hub.privacyTitle}</h2>
      <p>
        {hub.privacy} <a href={ROUTES[lang].privacy}>{hub.privacyLink}</a>.
      </p>
    </section>
  </div>
</Base>
