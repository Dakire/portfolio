---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import ToolCards from '../components/ToolCards.astro';
import '../styles/tools.css';
import { ROUTES, routeAlternates, type Lang } from '../lib/i18n';
import { HUB, TOOL_GROUPS } from '../tools/hub';
import { TOOLS, toolPath, toolUi } from '../tools/registry';
import { breadcrumbLd } from '../lib/seo';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const hub = HUB[lang];
const ld = {
  '@context': 'https://schema.org',
  '@graph': [
    breadcrumbLd([
      { name: hub.breadcrumb.home, path: ROUTES[lang].home },
      { name: hub.breadcrumb.tools, path: ROUTES[lang].tools },
    ]),
    {
      '@type': 'ItemList',
      name: hub.schemaName,
      itemListElement: TOOLS.map((tool, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        url: `https://grichard.eu${toolPath(tool, lang)}`,
        name: toolUi(tool, lang).name,
      })),
    },
  ],
};
---

<Base
  lang={lang}
  title={hub.meta.title}
  description={hub.meta.description}
  path={ROUTES[lang].tools}
  alternates={routeAlternates('tools')}
  ld={ld}
>
  <PageHero path="~/tools" title={hub.h1} lead={hub.intro} />
  <div class="container section stack-lg">
    <nav class="tool-groups-nav" aria-label={hub.groupsLabel}>
      <ul role="list">
        {TOOL_GROUPS.map((group, i) => (
          <li>
            <a href={`#${group.id}`}>
              <span class="label" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              {group[lang].title}
              <span class="tool-groups-count">{group.tools.length}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    {TOOL_GROUPS.map((group, i) => (
      <section class="tool-group" id={group.id} aria-labelledby={`${group.id}-title`}>
        <SectionHead id={`${group.id}-title`} index={i + 1} title={group[lang].title} />
        <p class="section-intro">{group[lang].text}</p>
        <ToolCards lang={lang} headingLevel={3} ids={group.tools} />
      </section>
    ))}

    <section class="tool-section" aria-labelledby="privacy-title">
      <h2 id="privacy-title">{hub.privacyTitle}</h2>
      <p>{hub.privacy}</p>
    </section>
  </div>
</Base>
