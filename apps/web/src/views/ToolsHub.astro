---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ToolCards from '../components/ToolCards.astro';
import '../styles/tools.css';
import { ROUTES, routeAlternates, type Lang } from '../lib/i18n';
import { HUB } from '../tools/hub';
import { TOOLS, toolPath, toolUi } from '../tools/registry';
import { breadcrumbLd } from '../lib/seo';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const hub = HUB[lang];
const ld = {
  '@context': 'https://schema.org',
  '@graph': [
    breadcrumbLd([
      { name: hub.breadcrumb.home, path: ROUTES[lang].home },
      { name: hub.breadcrumb.tools, path: ROUTES[lang].tools },
    ]),
    {
      '@type': 'ItemList',
      name: hub.schemaName,
      itemListElement: TOOLS.map((tool, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        url: `https://grichard.eu${toolPath(tool, lang)}`,
        name: toolUi(tool, lang).name,
      })),
    },
  ],
};
---

<Base
  lang={lang}
  title={hub.meta.title}
  description={hub.meta.description}
  path={ROUTES[lang].tools}
  alternates={routeAlternates('tools')}
  ld={ld}
>
  <PageHero path="~/tools" title={hub.h1} lead={hub.intro} />
  <div class="container section stack-lg">
    <ToolCards lang={lang} />

    <section class="tool-section" aria-labelledby="privacy-title">
      <h2 id="privacy-title">{hub.privacyTitle}</h2>
      <p>{hub.privacy}</p>
    </section>
  </div>
</Base>
