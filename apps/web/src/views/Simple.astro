---
// Pages « À propos », « Compétences », « Réalisations » et « Contact » : un même gabarit, le contenu change selon `page`.
import Button from '@grichard/ui/components/Button.astro';
import CtaBand from '@grichard/ui/components/CtaBand.astro';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ProjectCards from '../components/ProjectCards.astro';
import ContactIsland from '../contact/ContactForm';
import { PORTFOLIO_DATA, PROFILE } from '../data/content';
import { SKILL_RELATED, hasRelated, resolveRelated } from '../data/related';
import { SITE_TEXT } from '../data/site-text';
import '../styles/tools.css';
import { withBase } from '../lib/base';
import { crumbs } from '../lib/crumbs';
import { aboutLd, collectionLd, ogImage, skillsLd } from '../lib/seo-pages';
import { ROUTES, projectPath, routeAlternates, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
  page: 'about' | 'skills' | 'projects' | 'contact';
}
const { lang, page } = Astro.props;
const t = PORTFOLIO_DATA[lang];
const text = SITE_TEXT[lang];
const routes = ROUTES[lang];
const fr = lang === 'fr';

const heads = {
  about: {
    title: t.aboutTitle,
    description: fr
      ? "Qui est Guillaume Richard : technicien informatique passionné de réseaux, de messagerie cloud et d'automatisation. Profil, approche et CV."
      : 'Who Guillaume Richard is: an IT technician keen on networks, cloud email and automation. Profile, approach and resume.',
  },
  skills: {
    title: t.skillsTitle,
    description: fr
      ? 'Les six domaines de compétences de Guillaume Richard : réseau, sécurité, messagerie cloud, formation, développement et support, avec leurs preuves.'
      : "Guillaume Richard's six areas of expertise: networking, security, cloud email, training, development and support, with the work behind each.",
  },
  projects: {
    title: t.projectsTitle,
    description: fr
      ? 'Les réalisations de Guillaume Richard : homelab Proxmox, déploiement Windows Server, migrations de messagerie, support, outils C# et automatisation.'
      : "Guillaume Richard's projects: Proxmox homelab, Windows Server deployment, mailbox migrations, support, C# tools and automation.",
  },
  contact: {
    title: t.contactTitle,
    description: fr
      ? 'Contactez Guillaume Richard, technicien informatique : un message ou un e-mail suffit pour parler de votre besoin (réseau, Microsoft 365, Google Workspace).'
      : 'Contact Guillaume Richard, IT technician: one message or email is enough to talk about your needs (networks, Microsoft 365, Google Workspace).',
  },
} as const;
const head = heads[page];
const seoTitles = {
  about: fr
    ? 'À propos | Guillaume Richard, technicien informatique'
    : 'About | Guillaume Richard, IT technician',
  skills: fr
    ? 'Compétences : réseau, M365, sécurité | Guillaume Richard'
    : 'Skills: networks, M365, security | Guillaume Richard',
  projects: fr
    ? 'Réalisations | Guillaume Richard, technicien IT'
    : 'Projects | Guillaume Richard, IT technician',
  contact: fr
    ? 'Contact | Guillaume Richard, technicien informatique'
    : 'Contact | Guillaume Richard, IT technician',
} as const;
const pageTitle = seoTitles[page];
const trail = crumbs(lang, [], { label: head.title, path: routes[page] });
const pageInput = {
  lang,
  path: routes[page],
  name: pageTitle,
  description: head.description,
  crumbs: trail.ld,
};
const structured =
  page === 'about'
    ? aboutLd(pageInput, t.hero.role)
    : page === 'skills'
      ? skillsLd(pageInput, t.skills)
      : page === 'projects'
        ? collectionLd(
            pageInput,
            t.projects.map((p) => ({ title: p.title, path: projectPath(lang, p.slug) })),
          )
        : { '@context': 'https://schema.org', '@graph': [trail.ld] };
const labels = fr
  ? {
      cv: 'Télécharger mon CV (PDF)',
      career: 'Voir mon parcours',
      jump: 'Aller à un domaine',
      contactLead:
        'Un projet, une question, un souci à régler ? Écrivez-moi par e-mail ou avec le formulaire : je réponds personnellement.',
    }
  : {
      cv: 'Download my resume (PDF)',
      career: 'See my career',
      jump: 'Jump to an area',
      contactLead:
        'A project, a question, something to fix? Email me or use the form: I answer personally.',
    };

// Compétences : chaque domaine et ses preuves (réalisations, articles, outils, cheatsheets).
const skillBlocks =
  page === 'skills'
    ? await Promise.all(
        t.skills.map(async (skill) => ({
          skill,
          projects: t.projects.filter((p) => p.skill === skill.id),
          related: await resolveRelated(lang, SKILL_RELATED[skill.id]),
        })),
      )
    : [];
const domains = [...new Set(t.projects.map((p) => p.skill))].map((id) => ({
  id,
  label: t.skills.find((s) => s.id === id)?.category ?? id,
  items: t.projects.filter((p) => p.skill === id),
}));
---

<Base
  lang={lang}
  title={pageTitle}
  description={head.description}
  path={routes[page]}
  alternates={routeAlternates(page)}
  image={ogImage(`page-${page}-${lang}`, head.title)}
  ld={structured}
>
  <PageHero path={head.title} title={head.title} crumbs={trail}>
    {page === 'skills' && <p class="lead">{t.skillsIntro}</p>}
    {page === 'projects' && <p class="lead">{t.projectsIntro}</p>}
    {page === 'contact' && <p class="lead">{labels.contactLead}</p>}
  </PageHero>
  <div class="container stack-lg section">
    {page === 'about' && (
      <>
        <section class="stack" aria-labelledby="bio">
          <h2 id="bio" class="visually-hidden">
            {t.aboutTitle}
          </h2>
          <p class="prose lead">{t.about}</p>
          {t.aboutMore.map((p) => (
            <p class="prose">{p}</p>
          ))}
          <p class="row">
            <Button variant="primary" href={routes.career}>
              {labels.career}
            </Button>
            <Button href={withBase(t.hero.cvLink)}>{labels.cv}</Button>
          </p>
        </section>
        <section class="stack" aria-labelledby="about-skills">
          <h2 id="about-skills">{t.skillsTitle}</h2>
          <ul class="link-list">
            {t.skills.map((skill) => (
              <li>
                <a href={`${routes.skills}#${skill.id}`}>{skill.category}</a>
                <span class="meta"> · {skill.short}</span>
              </li>
            ))}
          </ul>
        </section>
      </>
    )}
    {page === 'skills' &&
      skillBlocks.map(({ skill, projects, related }) => (
        <section class="stack" id={skill.id} aria-labelledby={`${skill.id}-title`}>
          <h2 id={`${skill.id}-title`}>{skill.category}</h2>
          <p class="prose">{skill.items}</p>
          {(projects.length > 0 || hasRelated(related)) && (
            <div class="proofs">
              <p class="meta">{text.skills.proofs}</p>
              {projects.length > 0 && (
                <div>
                  <h3>{text.skills.projects}</h3>
                  <ul class="link-list">
                    {projects.map((p) => (
                      <li>
                        <a href={projectPath(lang, p.slug)}>{p.title}</a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
              {related.posts.length > 0 && (
                <div>
                  <h3>{text.skills.posts}</h3>
                  <ul class="link-list">
                    {related.posts.map((l) => (
                      <li>
                        <a href={l.href}>{l.label}</a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
              {related.tools.length > 0 && (
                <div>
                  <h3>{text.skills.tools}</h3>
                  <ul class="link-list">
                    {related.tools.map((l) => (
                      <li>
                        <a href={l.href}>{l.label}</a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
              {related.refs.length > 0 && (
                <div>
                  <h3>{text.skills.cheatsheets}</h3>
                  <ul class="link-list">
                    {related.refs.map((l) => (
                      <li>
                        <a href={l.href}>{l.label}</a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </div>
          )}
        </section>
      ))}
    {page === 'projects' && (
      <>
        <nav aria-label={labels.jump} class="section-nav">
          <ul>
            {domains.map((d) => (
              <li>
                <a href={`#${d.id}`}>{d.label}</a>
              </li>
            ))}
          </ul>
        </nav>
        {domains.map((d) => (
          <section class="stack" id={d.id} aria-labelledby={`${d.id}-title`}>
            <h2 id={`${d.id}-title`}>{d.label}</h2>
            <ProjectCards items={d.items} lang={lang} level={3} />
          </section>
        ))}
      </>
    )}
    {page === 'contact' && (
      <section class="stack" aria-labelledby="contact-direct">
        <h2 id="contact-direct">E-mail</h2>
        <p class="prose">
          <a href={`mailto:${PROFILE.email}`}>{PROFILE.email}</a> · {PROFILE.location}
        </p>
        <ContactIsland client:visible lang={lang} />
      </section>
    )}
    {page !== 'contact' && (
      <CtaBand title={text.contactBand.title}>
        <p>{text.contactBand.text}</p>
        <Fragment slot="actions">
          <Button variant="primary" href={routes.contact}>
            {t.hero.contactBtn}
          </Button>
        </Fragment>
      </CtaBand>
    )}
  </div>
</Base>
