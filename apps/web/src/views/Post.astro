---
import { render } from 'astro:content';
import Button from '@grichard/ui/components/Button.astro';
import CtaBand from '@grichard/ui/components/CtaBand.astro';
import Tag from '@grichard/ui/components/Tag.astro';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { PORTFOLIO_DATA, PROFILE } from '../data/content';
import { POST_RELATED, resolveRelated } from '../data/related';
import { SITE_TEXT } from '../data/site-text';
import {
  CATEGORIES,
  categoryPath,
  formatDate,
  getPosts,
  getTranslation,
  isoDate,
  postPath,
  readingMinutes,
  tagPath,
  type Post,
} from '../lib/blog';
import { ROUTES, SITE, UI, type Alternates, type Lang } from '../lib/i18n';
import { withBase } from '../lib/base';
import { postLd } from '../lib/seo';
import { ticketOf } from '../lib/ticket';
import '../styles/blog.css';

interface Props {
  post: Post;
}

// Marqueur de gravité (frontmatter « severity ») : symbole et mot, jamais la couleur seule.
const SEVERITY_MARK = { critical: '▲', warning: '●', fixed: '✓' } as const;
const SEVERITY_LABEL = {
  critical: { fr: 'Critique', en: 'Critical' },
  warning: { fr: 'Attention', en: 'Warning' },
  fixed: { fr: 'Correctif disponible', en: 'Fix available' },
} as const;
const { post } = Astro.props;
const ticket = ticketOf(post.data.date, post.data.category);
const lang: Lang = post.lang;
const t = PORTFOLIO_DATA[lang].blog;
const ui = UI[lang];
const authorAlt =
  lang === 'fr'
    ? 'Avatar dessiné de Guillaume Richard : cheveux bruns, barbe courte'
    : 'Drawn avatar of Guillaume Richard: brown hair, short beard';
const { Content, headings } = await render(post);
// Sommaire : la liste numérote déjà ; un intertitre « 4. Si un poste… » perd son numéro pour ne pas afficher « 04. 4. ».
const toc = headings
  .filter((h) => h.depth === 2)
  .map((h) => ({ ...h, text: h.text.replace(/^\d+\.\s+/, '') }));
const translation = await getTranslation(post);
const path = postPath(lang, post.slug);
const alternates: Partial<Alternates> = {
  [lang]: path,
  ...(translation ? { [translation.lang]: postPath(translation.lang, translation.slug) } : {}),
};
// Suites de lecture : même catégorie d'abord, puis tags en commun, puis les plus récents (3 au plus), pour qu'aucun article ne finisse sans suite.
const others = (await getPosts(lang)).filter((p) => p.slug !== post.slug);
// Articles voisins dans l'ordre chronologique (getPosts trie du plus récent au plus ancien).
const chrono = await getPosts(lang);
const at = chrono.findIndex((p) => p.slug === post.slug);
const next = at > 0 ? chrono[at - 1] : undefined;
const prev = at >= 0 ? chrono[at + 1] : undefined;
const sharedTags = (p: Post) => p.data.tags.filter((tag) => post.data.tags.includes(tag)).length;
const related = [
  ...others.filter((p) => p.data.category === post.data.category),
  ...others
    .filter((p) => p.data.category !== post.data.category && sharedTags(p) > 0)
    .sort((a, b) => sharedTags(b) - sharedTags(a)),
  ...others.filter((p) => p.data.category !== post.data.category && sharedTags(p) === 0),
].slice(0, 3);
const frSlug = lang === 'fr' ? post.slug : (post.data.translationOf ?? '');
const further = await resolveRelated(lang, POST_RELATED[frSlug]);
const furtherLinks = [...further.tools, ...further.refs];
const contactBand = SITE_TEXT[lang].contactBand;
// Titre de l'onglet : le suffixe de marque n'est ajouté que s'il tient dans ~65 caractères (au-delà, les résultats de recherche le tronquent).
const shortTitle = post.data.seoTitle ?? post.data.title;
const pageTitle =
  shortTitle.length + PROFILE.name.length + 3 <= 62
    ? `${shortTitle} | ${PROFILE.name}`
    : shortTitle;
const image = {
  url: `${SITE}${withBase(`/og/${post.slug}.png`)}`,
  width: 1200,
  height: 630,
  alt: post.data.title,
};
const crumbs = [
  { name: ui.crumbHome, path: ROUTES[lang].home },
  { name: PORTFOLIO_DATA[lang].nav.blog ?? 'Blog', path: ROUTES[lang].blog },
  { name: post.data.title, path },
];
---

<Base
  lang={lang}
  title={pageTitle}
  description={post.data.description}
  path={path}
  alternates={alternates}
  type="article"
  image={image}
  scripts={['/js/post.js', ...(post.data.script ? [post.data.script] : [])]}
  ld={postLd({
    lang,
    path,
    title: post.data.title,
    description: post.data.description,
    published: post.data.date,
    modified: post.data.updated,
    image: image.url,
    keywords: post.data.tags,
    crumbs,
    section: CATEGORIES[post.data.category]?.[lang],
    wordCount: (post.body ?? '').split(/\s+/).filter(Boolean).length,
    minutes: readingMinutes(post.body),
  })}
>
  <meta data-pagefind-filter="category[content]" content={CATEGORIES[post.data.category]?.[lang]} />
  {post.data.tags.map((tag) => (
    <meta data-pagefind-filter="tag[content]" content={tag} />
  ))}
  <meta data-pagefind-meta="date[content]" content={isoDate(post.data.date)} />
  <div class="container section post">
    <nav aria-label={ui.breadcrumb} class="meta breadcrumb">
      <ol class="row" role="list">
        {crumbs.slice(0, 2).map((c) => (
          <li>
            <a href={c.path}>{c.name}</a>
          </li>
        ))}
        <li aria-current="page">{post.data.title}</li>
      </ol>
    </nav>

    <div
      class="read-progress"
      data-read-progress
      role="progressbar"
      aria-label={lang === 'fr' ? 'Progression de la lecture' : 'Reading progress'}
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="0"
      hidden
    >
      <div></div>
    </div>
    <article
      data-copy-label={lang === 'fr' ? 'Copier' : 'Copy'}
      data-copy-aria={lang === 'fr' ? 'Copier le code' : 'Copy the code'}
      data-copied-label={lang === 'fr' ? 'Copié' : 'Copied'}
      data-copy-fail={lang === 'fr' ? 'Échec' : 'Failed'}
    >
      <header class="stack page-hero post-head">
        <p class="ticket post-ticket">
          <b>{ticket}</b>
        </p>
        <h1>{post.data.title}</h1>
        {post.data.severity && (
          <p class={`sev sev-${post.data.severity}`}>
            <span aria-hidden="true">{SEVERITY_MARK[post.data.severity]}</span>
            {SEVERITY_LABEL[post.data.severity][lang]}
          </p>
        )}
        <p class="lead">{post.data.summary ?? post.data.description}</p>
        <dl class="art-meta">
          <div>
            <dt class="label">{lang === 'fr' ? 'Publié' : 'Published'}</dt>
            <dd>
              <time datetime={isoDate(post.data.date)}>{formatDate(post.data.date, lang)}</time>
            </dd>
          </div>
          {post.data.updated && (
            <div>
              <dt class="label">{lang === 'fr' ? 'Mis à jour' : 'Updated'}</dt>
              <dd>
                <time datetime={isoDate(post.data.updated)}>
                  {formatDate(post.data.updated, lang)}
                </time>
              </dd>
            </div>
          )}
          <div>
            <dt class="label">{lang === 'fr' ? 'Rubrique' : 'Topic'}</dt>
            <dd>
              <a href={categoryPath(lang, post.data.category)}>
                {CATEGORIES[post.data.category]?.[lang]}
              </a>
            </dd>
          </div>
          <div>
            <dt class="label">{lang === 'fr' ? 'Lecture' : 'Reading'}</dt>
            <dd>
              {readingMinutes(post.body)} {t.min}
            </dd>
          </div>
          <div>
            <dt class="label">{lang === 'fr' ? 'Auteur' : 'Author'}</dt>
            <dd>{PROFILE.name}</dd>
          </div>
        </dl>
        {translation && (
          <p>
            <a
              href={postPath(translation.lang, translation.slug)}
              hreflang={translation.lang}
              lang={translation.lang}
            >
              {t.otherLang}
            </a>
          </p>
        )}
      </header>

      <div class="post-layout">
        {toc.length > 1 && (
          <nav class="toc" aria-labelledby="toc-title">
            <h2 id="toc-title" class="label">
              {t.toc}
            </h2>
            <ol role="list">
              {toc.map((h) => (
                <li>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ol>
          </nav>
        )}
        <div class="post-body">
          <Content />
        </div>
        {furtherLinks.length > 0 && (
          <aside class="post-aside" aria-labelledby="further-title">
            <h2 id="further-title" class="note">
              {lang === 'fr' ? 'Pour aller plus loin' : 'Go further'}
            </h2>
            <ul role="list">
              {furtherLinks.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))}
            </ul>
          </aside>
        )}
      </div>

      <section class="author" aria-labelledby="author-title">
        <div class="author-avatar">
          <img
            class="avatar-sombre"
            src={withBase('/img/guillaume-sombre.svg')}
            alt={authorAlt}
            width="72"
            height="72"
            loading="lazy"
            decoding="async"
          />
          <img
            class="avatar-clair"
            src={withBase('/img/guillaume-clair.svg')}
            alt={authorAlt}
            width="72"
            height="72"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="author-text">
          <h2 id="author-title" class="label">
            {lang === 'fr' ? 'Écrit par' : 'Written by'}
          </h2>
          <p>
            <b>{PROFILE.name}</b>
            <br />
            {PORTFOLIO_DATA[lang].hero.role}.{' '}
            <a href={ROUTES[lang].about}>{PORTFOLIO_DATA[lang].nav.about}</a>
          </p>
          <SocialLinks lang={lang} />
        </div>
      </section>

      <footer class="stack">
        <div class="post-share">
          <button type="button" class="btn" data-copy-link hidden>
            {lang === 'fr' ? 'Copier le lien' : 'Copy link'}
          </button>
          <button type="button" class="btn" data-share hidden>
            {lang === 'fr' ? 'Partager' : 'Share'}
          </button>
        </div>
        {(prev || next) && (
          <nav
            class="post-pager"
            aria-label={lang === 'fr' ? 'Articles voisins' : 'Neighbouring articles'}
          >
            {prev ? (
              <a href={postPath(prev.lang, prev.slug)} rel="prev">
                <span class="label">{lang === 'fr' ? 'Plus ancien' : 'Older'}</span>
                {prev.data.title}
              </a>
            ) : (
              <span />
            )}
            {next ? (
              <a href={postPath(next.lang, next.slug)} rel="next">
                <span class="label">{lang === 'fr' ? 'Plus récent' : 'Newer'}</span>
                {next.data.title}
              </a>
            ) : (
              <span />
            )}
          </nav>
        )}
        <ul class="row" role="list">
          {post.data.tags.map((tag) => (
            <li>
              <a href={tagPath(lang, tag)}>
                <Tag>{tag}</Tag>
              </a>
            </li>
          ))}
        </ul>
      </footer>
    </article>

    {related.length > 0 && (
      <section class="stack related" aria-labelledby="related-title">
        <div class="rubric">
          <h2 id="related-title">{t.related}</h2>
        </div>
        <ul class="ledger-list" role="list">
          {related.map((p) => (
            <li>
              <a class="ledger-row" href={postPath(p.lang, p.slug)}>
                <span class="ledger-meta">{ticketOf(p.data.date, p.data.category)}</span>
                <span class="ledger-title">
                  {p.data.title}
                  <span class="ledger-sub">
                    <time datetime={isoDate(p.data.date)}>{formatDate(p.data.date, p.lang)}</time>
                    {' · '}
                    {CATEGORIES[p.data.category]?.[p.lang]}
                  </span>
                </span>
                <span class="ledger-arrow" aria-hidden="true">
                  <Icon name="arrow" size={18} />
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <CtaBand title={contactBand.title}>
      <p>{contactBand.text}</p>
      <Fragment slot="actions">
        <Button variant="primary" href={ROUTES[lang].contact}>
          {PORTFOLIO_DATA[lang].hero.contactBtn}
        </Button>
      </Fragment>
    </CtaBand>
  </div>
</Base>
