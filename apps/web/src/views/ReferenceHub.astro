---
import Shape from '../components/Shape.astro';
import { tone } from '../lib/tones';
// Accueil « Cheatsheets » : la liste des cheatsheets. Pas de recherche globale (trop de résultats mélangés) : chaque cheatsheet a la sienne.
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import '../styles/reference.css';
import { ROUTES, type Lang } from '../lib/i18n';
import { cheatsheetsHubLd, ogImage } from '../lib/seo-pages';
import { crumbs } from '../lib/crumbs';
import { UI } from '../lib/i18n';
import { REF_UI, hubAlternates, hubPath, refPath, refsFor } from '../reference/refs';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const ui = REF_UI[lang];
const refs = refsFor(lang);
const trail = crumbs(lang, [{ label: UI[lang].nav.resources, path: ROUTES[lang].resources }], {
  label: ui.crumb,
  path: hubPath(lang),
});
const ld = cheatsheetsHubLd(
  {
    lang,
    path: hubPath(lang),
    name: ui.hubTitle,
    description: ui.hubDescription,
    crumbs: trail.ld,
  },
  refs.map((r) => ({ title: r.h1, path: refPath(r), description: r.description })),
);
---

<Base
  lang={lang}
  title={ui.hubTitle}
  description={ui.hubDescription}
  path={hubPath(lang)}
  alternates={hubAlternates()}
  image={ogImage(`page-cheatsheets-${lang}`, ui.hubH1)}
  ld={ld}
>
  <PageHero title={ui.hubH1} lead={ui.hubIntro} crumbs={trail} />
  <h2 class="visually-hidden" id="ref-cards-title">
    {ui.cards}
  </h2>
  {refs.map((r, i) => (
    <section class={`band band-${tone(i)}`} aria-labelledby={`ref-${r.id}-title`}>
      {i === 0 && <Shape variant="blob" />}
      <div class="container ref-band">
        <div class="ref-band-text">
          <h3 id={`ref-${r.id}-title`}>
            <a class="ref-band-title" href={refPath(r)}>
              {r.h1}
            </a>
          </h3>
          <p>{r.card}</p>
        </div>
        <a class="btn ref-band-link" href={refPath(r)}>
          {r.count} {ui.entries} · {ui.open}
          <span class="arrow" aria-hidden="true">
            →
          </span>
        </a>
      </div>
    </section>
  ))}
</Base>
