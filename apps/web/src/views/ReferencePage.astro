---
// Page d'une cheatsheet : introduction, blocs statiques (« Connexion »…), recherche, liste complète en HTML, liens associés, source et licence.
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import RefTop from '../components/RefTop.astro';
import ReferenceSearch from '../components/ReferenceSearch.astro';
import '../styles/reference.css';
import { REF_PROJECTS, REF_RELATED, hasRelated, resolveRelated } from '../data/related';
import { crumbs } from '../lib/crumbs';
import { ROUTES, UI, type Lang } from '../lib/i18n';
import { cheatsheetLd, ogImage } from '../lib/seo-pages';
import {
  REF_UI,
  hubPath,
  loadEntries,
  refAlternates,
  refFrId,
  refPath,
  type RefMeta,
} from '../reference/refs';

interface Props {
  lang: Lang;
  reference: RefMeta;
}
const { lang, reference: ref } = Astro.props;
const ui = REF_UI[lang];
const path = refPath(ref);
const frId = refFrId(ref);
const trail = crumbs(
  lang,
  [
    { label: UI[lang].nav.resources, path: ROUTES[lang].resources },
    { label: ui.crumb, path: hubPath(lang) },
  ],
  { label: ref.h1, path },
);

// Liste complète rendue en HTML (la recherche, elle, se construit côté client) : le contenu existe pour les moteurs et sans JavaScript.
// Au-delà de 150 entrées (GAM), la page resterait trop lourde : seule la recherche les présente.
const entries = ref.count <= 150 ? loadEntries(ref) : [];
const related = await resolveRelated(lang, { ...REF_RELATED[frId], projects: REF_PROJECTS[frId] });
const links = [
  { title: ui.relatedPosts, items: related.posts },
  { title: ui.relatedTools, items: related.tools },
  { title: ui.relatedRefs, items: related.refs.filter((l) => l.href !== path) },
  { title: ui.relatedProjects, items: related.projects },
].filter((group) => group.items.length > 0);
---

<Base
  lang={lang}
  title={ref.title}
  description={ref.description}
  path={path}
  alternates={refAlternates(ref)}
  image={ogImage(`cheatsheet-${ref.id}`, ref.h1)}
  ld={cheatsheetLd({
    lang,
    path,
    title: ref.h1,
    description: ref.description,
    topics: ref.cats.map((cat) => cat.label),
    count: ref.count,
    hubPath: hubPath(lang),
    source: ref.source,
    crumbs: trail.ld,
  })}
  scripts={['/js/libs/minisearch.js', '/js/reference.js']}
>
  <PageHero title={ref.h1} lead={ref.intro} crumbs={trail} />
  <div class="container section stack-lg">
    {ref.notice && (
      <p class="ref-notice" role="note">
        {ref.notice}
      </p>
    )}
    {!ref.topAfter && <RefTop lang={lang} reference={ref} id="ref-top-title" />}
    <ReferenceSearch lang={lang} ref={ref} cats={ref.cats} />
    {ref.topAfter && <RefTop lang={lang} reference={ref} id="ref-top-title-after" />}
    {entries.length > 0 && (
      <section class="stack" aria-labelledby="ref-all-title">
        <h2 id="ref-all-title">{ui.allTitle}</h2>
        <details class="ref-all">
          <summary>{ui.allSummary(entries.length)}</summary>
          <ul class="ref-all-list" role="list">
            {entries.map((entry) => (
              <li>
                <h3>
                  <code>{entry.name}</code>
                </h3>
                {entry.syn && (
                  <p>
                    <code>{entry.syn}</code>
                  </p>
                )}
                {entry.desc && <p>{entry.desc}</p>}
                {entry.ex && entry.ex.length > 0 && <pre><code>{entry.ex.join('\n')}</code></pre>}
              </li>
            ))}
          </ul>
        </details>
      </section>
    )}
    {hasRelated(related) && (
      <section class="stack" aria-labelledby="ref-related-title">
        <h2 id="ref-related-title">{ui.related}</h2>
        <div class="proofs">
          {links.map((group) => (
            <div>
              <h3>{group.title}</h3>
              <ul class="link-list">
                {group.items.map((item) => (
                  <li>
                    <a href={item.href}>{item.label}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>
    )}
    {ref.source && (
      <section class="stack" aria-labelledby="ref-source-title">
        <h2 id="ref-source-title">{ui.sourceTitle}</h2>
        <p class="ref-source">
          {ui.sourceBy} <a href={ref.source.url}>{ref.source.name}</a>. {ui.license} :
          <a href={ref.source.licenseUrl}>{ref.source.license}</a>.{ref.source.note}
        </p>
      </section>
    )}
    <p class="ref-source">{ui.privacy}</p>
  </div>
</Base>
