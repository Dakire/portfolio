---
// Page « Parcours » : le CV en ligne (expériences, formation, langues) et les deux CV en PDF.
import Button from '@grichard/ui/components/Button.astro';
import CtaBand from '@grichard/ui/components/CtaBand.astro';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ExperienceList from '../components/ExperienceList.astro';
import { PORTFOLIO_DATA, PROFILE } from '../data/content';
import { SITE_TEXT } from '../data/site-text';
import { withBase } from '../lib/base';
import { crumbs } from '../lib/crumbs';
import { careerLd, ogImage } from '../lib/seo-pages';
import { ROUTES, projectPath, routeAlternates, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = PORTFOLIO_DATA[lang];
const text = SITE_TEXT[lang];
const routes = ROUTES[lang];
const title =
  lang === 'fr'
    ? 'Parcours professionnel | Guillaume Richard, technicien IT'
    : 'Career | Guillaume Richard, IT technician';
const fr = lang === 'fr';
const skillsLabel = fr ? 'Compétences mises en œuvre' : 'Skills used';
const projectTitle = (slug: string) => t.projects.find((p) => p.slug === slug)?.title ?? slug;
const trail = crumbs(lang, [], { label: text.career.title, path: routes.career });
---

<Base
  lang={lang}
  title={title}
  description={text.career.description}
  path={routes.career}
  alternates={routeAlternates('career')}
  image={ogImage(`page-career-${lang}`, text.career.title)}
  ld={careerLd(
    {
      lang,
      path: routes.career,
      name: title,
      description: text.career.description,
      crumbs: trail.ld,
    },
    t.hero.role,
    t.experiences,
    t.education.map((e) => `${e.title} - ${e.school}`),
  )}
>
  <PageHero path={text.career.title} title={text.career.title} crumbs={trail}>
    <p class="lead">{t.experienceIntro}</p>
  </PageHero>
  <div class="container section">
    <section class="stack" aria-labelledby="experiences">
      <h2 id="experiences">{t.experienceTitle}</h2>
      <ExperienceList
        items={t.experiences}
        level={3}
        skillsLabel={skillsLabel}
        dutiesLabel={fr ? 'Missions, entre autres :' : 'Duties include:'}
      />
    </section>
  </div>
  <section class="band band-olive" aria-labelledby="education">
    <div class="container stack hm-section">
      <h2 id="education">{t.educationTitle}</h2>
      <ol class="jobs">
        {t.education.map((e) => (
          <li class="job">
            <div class="job-when">
              <p class="job-date">{e.date}</p>
              <p class="job-where">{e.school}</p>
            </div>
            <div class="job-what">
              <h3>{e.title}</h3>
              {e.points && e.points.length > 0 && (
                <ul class="points">
                  {e.points.map((point) => (
                    <li>{point}</li>
                  ))}
                </ul>
              )}
              {e.skills && e.skills.length > 0 && (
                <ul class="row skill-tags" role="list" aria-label={skillsLabel}>
                  {e.skills.map((skill) => (
                    <li>
                      <span class="tag">{skill}</span>
                    </li>
                  ))}
                </ul>
              )}
              {e.projects && e.projects.length > 0 && (
                <p class="meta">
                  {fr ? 'Réalisations liées : ' : 'Related projects: '}
                  {e.projects.map((slug, i) => (
                    <>
                      {i > 0 && ' · '}
                      <a href={projectPath(lang, slug)}>{projectTitle(slug)}</a>
                    </>
                  ))}
                </p>
              )}
            </div>
          </li>
        ))}
      </ol>
      <p class="prose">{t.languagesInfo}</p>
    </div>
  </section>
  <section class="band band-ardoise" aria-labelledby="cv">
    <div class="container stack hm-section">
      <h2 id="cv">{text.career.cvTitle}</h2>
      <p class="prose">{text.career.cvText}</p>
      <ul class="row" role="list">
        {t.hero.cvLinks.map((cv) => (
          <li>
            <Button href={withBase(cv.href)} hreflang={cv.lang} lang={cv.lang}>
              {cv.label}
            </Button>
          </li>
        ))}
      </ul>
    </div>
  </section>
  <div class="container section">
    <CtaBand title={text.contactBand.title}>
      <p>{text.contactBand.text}</p>
      <Fragment slot="actions">
        <Button variant="primary" href={routes.contact}>
          {t.hero.contactBtn}
        </Button>
      </Fragment>
    </CtaBand>
  </div>
</Base>
