---
// Page « Ressources » : présente le blog, les outils et les cheatsheets comme le prolongement du métier,
// avec des situations concrètes (et des exemples à saisir) pour savoir laquelle ouvrir.
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import '../styles/reference.css';
import { PORTFOLIO_DATA } from '../data/content';
import { resolveRelated } from '../data/related';
import { SITE_TEXT } from '../data/site-text';
import { CATEGORIES, getPosts, isoDate, postPath } from '../lib/blog';
import { crumbs } from '../lib/crumbs';
import { collectionLd, ogImage } from '../lib/seo-pages';
import { ROUTES, routeAlternates, type Lang } from '../lib/i18n';
import { resourceLinks } from '../lib/sections';
import { ticketOf } from '../lib/ticket';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = PORTFOLIO_DATA[lang];
const text = SITE_TEXT[lang].resources;
const routes = ROUTES[lang];
const title =
  lang === 'fr'
    ? 'Blog, outils et cheatsheets IT | Guillaume Richard'
    : 'IT blog, tools and cheatsheets | Guillaume Richard';
const trail = crumbs(lang, [], { label: text.title, path: routes.resources });
const posts = (await getPosts(lang)).slice(0, 3);
const links = resourceLinks(lang);
const cards = [
  { key: 'blog', title: t.nav.blog, text: text.blogText },
  { key: 'tools', title: t.nav.tools, text: text.toolsText },
  { key: 'cheatsheets', title: t.nav.cheatsheets, text: text.cheatsheetsText },
].flatMap((card) => {
  const link = links.find((l) => l.key === card.key);
  return link ? [{ ...card, href: link.href }] : [];
});

// Exemples : chaque situation pointe vers sa ressource ; celles qui n'existent pas dans cette langue sont omises.
const examples = (
  await Promise.all(
    text.examples.map(async (example) => {
      const resolved = await resolveRelated(lang, {
        tools: example.kind === 'tool' ? [example.id] : [],
        refs: example.kind === 'ref' ? [example.id] : [],
        posts: example.kind === 'post' ? [example.id] : [],
      });
      const link = resolved.tools[0] ?? resolved.refs[0] ?? resolved.posts[0];
      return link ? [{ ...example, href: link.href }] : [];
    }),
  )
).flat();
---

<Base
  lang={lang}
  title={title}
  description={text.description}
  path={routes.resources}
  alternates={routeAlternates('resources')}
  image={ogImage(`page-resources-${lang}`, text.title)}
  ld={collectionLd(
    {
      lang,
      path: routes.resources,
      name: title,
      description: text.description,
      crumbs: trail.ld,
    },
    cards.map((card) => ({ title: card.title, path: card.href })),
  )}
>
  <PageHero path={text.title} title={text.title} crumbs={trail}>
    <p class="lead">{text.intro}</p>
  </PageHero>
  <div class="container res-page">
    <section class="res-section" aria-labelledby="sections">
      <div class="rubric">
        <h2 id="sections">{text.title}</h2>
        <p class="rubric-meta">{cards.length}</p>
      </div>
      <ul class="ledger-list" role="list">
        {cards.map((card) => (
          <li>
            <a class="ledger-row" href={card.href}>
              <span class="ledger-meta res-open">{text.open}</span>
              <span class="ledger-title">
                {card.title}
                <span class="ledger-sub">{card.text}</span>
              </span>
              <span class="ledger-arrow" aria-hidden="true">
                →
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="res-section" aria-labelledby="examples">
      <div class="rubric">
        <h2 id="examples">{text.examplesTitle}</h2>
      </div>
      <p class="prose">{text.examplesIntro}</p>
      <ul class="ledger-list" role="list">
        {examples.map((example) => (
          <li>
            <a class="ledger-row" href={example.href}>
              <span class="ledger-meta res-open">{example.linkLabel}</span>
              <span class="ledger-title">
                {example.situation}
                <span class="ledger-sub">{example.text}</span>
                {example.code && (
                  <span class="res-code">
                    <code>{example.code}</code>
                  </span>
                )}
              </span>
              <span class="ledger-arrow" aria-hidden="true">
                →
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    {posts.length > 0 && (
      <section class="res-section" aria-labelledby="latest">
        <div class="rubric">
          <h2 id="latest">{text.latest}</h2>
          <p class="rubric-meta">
            <a href={routes.blog}>{t.blog.all} →</a>
          </p>
        </div>
        <ul class="ledger-list" role="list">
          {posts.map((post) => (
            <li>
              <a class="ledger-row" href={postPath(lang, post.slug)}>
                <span class="ledger-meta">{ticketOf(post.data.date, post.data.category)}</span>
                <span class="ledger-title">
                  {post.data.title}
                  <span class="ledger-sub">
                    {CATEGORIES[post.data.category]?.[lang]} ·{' '}
                    <time datetime={isoDate(post.data.date)}>{isoDate(post.data.date)}</time>
                  </span>
                </span>
                <span class="ledger-arrow" aria-hidden="true">
                  →
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>
</Base>
