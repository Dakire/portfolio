---
import Button from '@grichard/ui/components/Button.astro';
import CtaBand from '@grichard/ui/components/CtaBand.astro';
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import BandEdge from '../components/BandEdge.astro';
import Terminal from '../components/Terminal.astro';
import { PORTFOLIO_DATA, PROFILE } from '../data/content';
import { SITE_TEXT } from '../data/site-text';
import { CATEGORIES, getPosts, isoDate, postPath } from '../lib/blog';
import { withBase } from '../lib/base';
import { ROUTES, projectPath, routeAlternates, type Lang } from '../lib/i18n';
import { homeLd } from '../lib/seo';
import { resourceLinks } from '../lib/sections';
import { refsFor } from '../reference/refs';
import { TOOL_ICONS } from '../tools/icons';
import { TOOLS, findTool, toolPath, toolUi } from '../tools/registry';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = PORTFOLIO_DATA[lang];
const text = SITE_TEXT[lang];
const routes = ROUTES[lang];
const posts = await getPosts(lang);
const reading = posts.slice(0, 4);
const demo = text.home.cheatDemo;
// Le nom en deux temps : le prénom à l'encre, le nom en couleur d'accent (sur sa propre ligne en grand écran).
const [firstName, ...rest] = PROFILE.name.split(' ');
const lastName = rest.join(' ');
const dateFmt = new Intl.DateTimeFormat(lang === 'fr' ? 'fr-FR' : 'en-GB', {
  day: '2-digit',
  month: '2-digit',
  year: 'numeric',
  timeZone: 'UTC',
});
const featured = t.projects.filter((p) => p.featured);
const skillName = (id: string) => t.skills.find((s) => s.id === id)?.category ?? '';
const cheatsheets = resourceLinks(lang).find((l) => l.key === 'cheatsheets');

// Sommaire du site : les nombres sont comptés, jamais saisis à la main.
const index = [
  {
    href: routes.projects,
    name: t.nav.projects,
    count: t.projects.length,
    desc: text.home.index.projects,
  },
  { href: routes.tools, name: t.nav.tools, count: TOOLS.length, desc: text.home.index.tools },
  ...(cheatsheets
    ? [
        {
          href: cheatsheets.href,
          name: t.nav.cheatsheets,
          count: refsFor(lang).length,
          desc: text.home.index.cheatsheets,
        },
      ]
    : []),
  { href: routes.blog, name: t.nav.blog, count: posts.length, desc: text.home.index.posts },
];

// Outils mis en avant : ceux qui répondent aux questions les plus fréquentes en support (cinq tuiles autour de la recherche).
const homeTools = ['dns', 'email-headers', 'propagation', 'subnet', 'seo'].flatMap((id) => {
  const tool = findTool(id);
  return tool ? [{ ...toolUi(tool, lang), href: toolPath(tool, lang), icon: tool.icon }] : [];
});
---

<Base
  lang={lang}
  title={t.meta.title}
  description={t.meta.description}
  path={routes.home}
  alternates={routeAlternates('home')}
  ld={homeLd(lang, t.meta.title, t.hero.role)}
>
  <header class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="label led hero-kicker">{t.hero.role}</p>
        <p class="hero-hello">{t.hero.greeting}</p>
        <h1 class="hero-title">
          {firstName} <span>{lastName}</span>
        </h1>
        <p class="hero-pitch">{t.hero.pitch}</p>
        <p class="row hero-actions">
          <Button variant="primary" href={routes.projects}>
            {t.hero.projectsBtn}{' '}
            <span class="arrow" aria-hidden="true">
              →
            </span>
          </Button>
          <Button href={routes.contact}>{t.hero.contactBtn}</Button>
          <a class="hero-cv" href={withBase(t.hero.cvLink)}>
            {t.hero.cvBtn}
          </a>
        </p>
      </div>
      <Terminal lang={lang} />
    </div>

    <nav class="container site-index" aria-label={text.home.indexLabel}>
      <ul role="list">
        {index.map((item) => (
          <li>
            <a href={item.href}>
              <span class="site-index-count">{item.count}</span>
              <span class="site-index-name">
                {item.name} <span aria-hidden="true">→</span>
              </span>
              <span class="site-index-desc">{item.desc}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </header>

  <div class="container sections">
    <section aria-labelledby="skills-title">
      <SectionHead
        id="skills-title"
        eyebrow={text.home.eyebrows.skills}
        title={text.home.skillsTitle}
        more={{ href: routes.skills, label: text.home.skillsMore }}
      />
      <ol class="ports" role="list">
        {t.skills.map((skill, i) => (
          <li>
            <a href={`${routes.skills}#${skill.id}`}>
              <span class="port-id" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <span class="port-body">
                <span class="port-name">{skill.category}</span>
                <span class="port-desc">{skill.short}</span>
              </span>
            </a>
          </li>
        ))}
      </ol>
    </section>
  </div>

  <BandEdge position="top" seed={11} />
  <section class="band home-band" aria-labelledby="projects-title">
    <div class="container">
      <SectionHead
        id="projects-title"
        eyebrow={text.home.eyebrows.projects}
        title={text.home.featuredTitle}
        more={{ href: routes.projects, label: t.projectsAll }}
      />
      <ul class="band-projects" role="list">
        {featured.map((project) => (
          <li class="band-project">
            <div class="band-project-text">
              <p class="label">
                {skillName(project.skill)}
                {project.kind && <> · {text.project.kinds[project.kind]}</>}
              </p>
              <h3>
                <a href={projectPath(lang, project.slug)}>{project.title}</a>
              </h3>
              <p>{project.desc}</p>
            </div>
            <dl class="spec-sheet">
              <div>
                <dt>{lang === 'fr' ? 'Domaine' : 'Area'}</dt>
                <dd>{skillName(project.skill)}</dd>
              </div>
              <div>
                <dt>{lang === 'fr' ? 'Outils' : 'Tools'}</dt>
                <dd>{project.tags.join(' · ')}</dd>
              </div>
            </dl>
          </li>
        ))}
      </ul>
    </div>
  </section>
  <BandEdge position="bottom" seed={29} />

  <div class="container sections">
    <section aria-labelledby="tools-title">
      <SectionHead
        id="tools-title"
        eyebrow={text.home.eyebrows.tools}
        title={text.home.toolsTitle}
        more={{
          href: routes.tools,
          label: text.home.toolsMore.replace('{n}', String(TOOLS.length)),
        }}
      />
      <p class="section-intro">{text.home.toolsIntro}</p>
      <ul class="bento" role="list">
        <li class="tile bento-search">
          <h3>
            <a href={withBase(demo.href)}>{demo.title}</a>
          </h3>
          <p class="demo-field" aria-hidden="true">
            <span>{demo.query}</span>
            <kbd class="kbd">/</kbd>
          </p>
          <div class="demo-hit">
            <p class="demo-name">{demo.name}</p>
            <p>{demo.desc}</p>
            {demo.ex && <pre><code>{demo.ex}</code></pre>}
          </div>
          {cheatsheets && (
            <p class="demo-more">
              <a class="more-link" href={cheatsheets.href}>
                {t.nav.cheatsheets} ({refsFor(lang).length}){' '}
                <span class="arrow" aria-hidden="true">
                  →
                </span>
              </a>
            </p>
          )}
        </li>
        {homeTools.map((tool) => {
          const Icon = TOOL_ICONS[tool.icon];
          return (
            <li class="tile bento-tool">
              <Icon size={20} class="bento-icon" aria-hidden="true" />
              <h3>
                <a href={tool.href}>{tool.name}</a>
              </h3>
              <p>{tool.card}</p>
            </li>
          );
        })}
      </ul>
    </section>

    <div class="home-split">
      <section aria-labelledby="career-title">
        <SectionHead
          id="career-title"
          eyebrow={text.home.eyebrows.career}
          title={text.home.careerTitle}
          more={{ href: routes.career, label: text.home.careerMore }}
        />
        <ol class="log" role="list">
          {t.experiences.map((job) => (
            <li>
              <span class="log-date">{job.date}</span>
              <span class="log-role">{job.role}</span>
              <span class="log-org">{job.company}</span>
            </li>
          ))}
        </ol>
      </section>

      <section aria-labelledby="reading-title">
        <SectionHead
          id="reading-title"
          eyebrow={text.home.eyebrows.reading}
          title={text.home.readingTitle}
          more={{ href: routes.blog, label: text.home.readingMore }}
        />
        <ol class="reading" role="list">
          {reading.map((post) => (
            <li>
              <time datetime={isoDate(post.data.date)}>{dateFmt.format(post.data.date)}</time>
              <a href={postPath(lang, post.slug)}>{post.data.title}</a>
              <span class="reading-cat">{CATEGORIES[post.data.category]?.[lang]}</span>
            </li>
          ))}
        </ol>
      </section>
    </div>

    <section id="contact" aria-labelledby="contact-title">
      <CtaBand title={text.home.contactTitle}>
        <p>{text.home.contactText}</p>
        <p>
          <a href={`mailto:${PROFILE.email}`}>{PROFILE.email}</a>
        </p>
        <Fragment slot="actions">
          <Button variant="primary" href={routes.contact}>
            {t.hero.contactBtn}{' '}
            <span class="arrow" aria-hidden="true">
              →
            </span>
          </Button>
          <Button href={withBase(t.hero.cvLink)}>{t.hero.cvBtn}</Button>
        </Fragment>
      </CtaBand>
    </section>
  </div>
</Base>
