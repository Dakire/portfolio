---
import Button from '@grichard/ui/components/Button.astro';
import Card from '@grichard/ui/components/Card.astro';
import CtaBand from '@grichard/ui/components/CtaBand.astro';
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import ProjectCards from '../components/ProjectCards.astro';
import SkillCards from '../components/SkillCards.astro';
import Terminal from '../components/Terminal.astro';
import { PORTFOLIO_DATA, PROFILE } from '../data/content';
import { SITE_TEXT } from '../data/site-text';
import { getPosts } from '../lib/blog';
import { withBase } from '../lib/base';
import { ROUTES, routeAlternates, type Lang } from '../lib/i18n';
import { homeLd } from '../lib/seo';
import { resourceLinks } from '../lib/sections';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = PORTFOLIO_DATA[lang];
const text = SITE_TEXT[lang];
const routes = ROUTES[lang];
const [latest] = await getPosts(lang);
const featured = t.projects.filter((p) => p.featured);
const links = resourceLinks(lang);
const resourceCards = [
  { key: 'blog', title: t.nav.blog, text: text.resources.blogText },
  { key: 'tools', title: t.nav.tools, text: text.resources.toolsText },
  { key: 'cheatsheets', title: t.nav.cheatsheets, text: text.resources.cheatsheetsText },
].flatMap((card) => {
  const link = links.find((l) => l.key === card.key);
  return link ? [{ ...card, href: link.href }] : [];
});
---

<Base
  lang={lang}
  title={t.meta.title}
  description={t.meta.description}
  path={routes.home}
  alternates={routeAlternates('home')}
  ld={homeLd(lang, t.meta.title, t.hero.role)}
>
  <header class="page-hero grid-bg">
    <div class="container hero-grid">
      <div class="stack">
        <p class="hero-badge">{PROFILE.location}</p>
        <h1 class="hero-title">
          {t.hero.greeting} <span>{PROFILE.name}</span>
        </h1>
        <p class="lead">{t.hero.role}</p>
        <p class="prose">{t.hero.pitch}</p>
        <p class="row">
          <Button variant="primary" href={routes.projects}>
            {t.hero.projectsBtn}
          </Button>
          <Button href={routes.contact}>{t.hero.contactBtn}</Button>
          <Button variant="ghost" href={withBase(t.hero.cvLink)}>
            {t.hero.cvBtn}
          </Button>
        </p>
      </div>
      <Terminal lang={lang} />
    </div>
  </header>

  <div class="container sections">
    <section id="skills" aria-labelledby="skills-title" class="stack">
      <h2 id="skills-title">{t.skillsTitle}</h2>
      <SkillCards skills={t.skills} compact={{ href: routes.skills }} />
      <p>
        <a href={routes.skills}>{text.home.skillsMore} →</a>
      </p>
    </section>

    <section id="projects" aria-labelledby="projects-title" class="stack">
      <h2 id="projects-title">{text.home.featuredTitle}</h2>
      <ProjectCards items={featured} lang={lang} level={3} />
      <p>
        <a href={routes.projects}>{t.projectsAll} →</a>
      </p>
    </section>

    <section id="career" aria-labelledby="career-title" class="stack">
      <h2 id="career-title">{text.home.careerTitle}</h2>
      <p class="prose">{text.home.careerIntro}</p>
      <ol class="career-glance">
        {t.experiences.map((job) => (
          <li>
            <span class="career-role">{job.role}</span>
            <span class="meta">
              {job.company} · {job.date}
            </span>
          </li>
        ))}
      </ol>
      <p>
        <a href={routes.career}>{text.home.careerMore} →</a>
      </p>
    </section>

    <section id="resources" aria-labelledby="resources-title" class="stack">
      <h2 id="resources-title">{text.home.resourcesTitle}</h2>
      <p class="prose">{text.home.resourcesIntro}</p>
      <div class="cards cards-wide">
        {resourceCards.map((card) => (
          <Card class="card-stretch">
            <h3>
              <a class="card-link" href={card.href}>
                {card.title}
              </a>
            </h3>
            <p>{card.text}</p>
          </Card>
        ))}
      </div>
      {latest && (
        <div class="stack">
          <h3>{t.blog.title}</h3>
          <div class="cards cards-wide">
            <PostCard post={latest} minLabel={t.blog.min} />
          </div>
        </div>
      )}
      <p>
        <a href={routes.resources}>{text.resources.title} →</a>
      </p>
    </section>

    <section id="contact" aria-labelledby="contact-title">
      <CtaBand title={text.home.contactTitle}>
        <p>{text.home.contactText}</p>
        <p>
          <a href={`mailto:${PROFILE.email}`}>{PROFILE.email}</a>
        </p>
        <Fragment slot="actions">
          <Button variant="primary" href={routes.contact}>
            {t.hero.contactBtn}
          </Button>
          <Button href={withBase(t.hero.cvLink)}>{t.hero.cvBtn}</Button>
        </Fragment>
      </CtaBand>
    </section>
  </div>
</Base>
