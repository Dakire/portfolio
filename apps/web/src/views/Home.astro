---
import Shape from '../components/Shape.astro';
import Base from '../layouts/Base.astro';
import AvatarPortrait from '../components/AvatarPortrait.astro';
import CareerTimeline from '../components/CareerTimeline.astro';
import Icon from '../components/Icon.astro';
import ProjectArt from '../components/ProjectArt.astro';
import SocialLinks from '../components/SocialLinks.astro';
import Terminal from '../components/Terminal.astro';
import { PORTFOLIO_DATA, PROFILE } from '../data/content';
import { SITE_TEXT } from '../data/site-text';
import { CATEGORIES, getPosts, isoDate, postPath } from '../lib/blog';
import { withBase } from '../lib/base';
import { ROUTES, projectPath, routeAlternates, type Lang } from '../lib/i18n';
import { homeLd } from '../lib/seo';
import { resourceLinks } from '../lib/sections';
import { refsFor } from '../reference/refs';
import { TOOLS, findTool, toolPath, toolUi } from '../tools/registry';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const fr = lang === 'fr';
const t = PORTFOLIO_DATA[lang];
const text = SITE_TEXT[lang];
const routes = ROUTES[lang];
const posts = await getPosts(lang);
const [lead, ...others] = posts;
const reading = others.slice(0, 3);
const demo = text.home.cheatDemo;
const [firstName, ...rest] = PROFILE.name.split(' ');
const lastName = rest.join(' ');
const dayFmt = new Intl.DateTimeFormat(fr ? 'fr-FR' : 'en-GB', {
  day: 'numeric',
  month: 'short',
  timeZone: 'UTC',
});
const longFmt = new Intl.DateTimeFormat(fr ? 'fr-FR' : 'en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});
const featured = t.projects.filter((p) => p.featured);
const skillName = (id: string) => t.skills.find((s) => s.id === id)?.category ?? '';
const cheatsheets = resourceLinks(lang).find((l) => l.key === 'cheatsheets');
// Outils mis en avant : ceux qui répondent aux questions les plus fréquentes en support
const homeTools = ['units', 'dns', 'seo', 'email-headers', 'subnet'].flatMap((id) => {
  const tool = findTool(id);
  return tool ? [{ ...toolUi(tool, lang), href: toolPath(tool, lang) }] : [];
});
// Phrase d'accroche du profil (reprise du texte « À propos », dans les deux langues)
const statement = fr
  ? {
      main: "J'ai toujours testé les choses pour comprendre comment elles marchent.",
      sub: "Quand une tâche revient, j'écris l'outil qui la fait à ma place.",
    }
  : {
      main: 'I have always tested things to see how they work.',
      sub: 'When a task keeps coming back, I write the tool that does it for me.',
    };
const labels = fr
  ? {
      portfolio: 'Portfolio',
      projects: 'Réalisations',
      profile: 'Profil',
      expertise: "Domaines d'expertise",
      career: 'Parcours, à l’échelle',
      careerMore: 'Parcours détaillé, missions et formation',
      writing: 'Ce que j’écris',
      blog: 'Blog',
      allPosts: `Les ${posts.length} articles du blog`,
      building: 'Ce que je construis',
      tools: 'Outils et aide-mémoire',
      tool: 'Outil',
      cheat: 'Aide-mémoire',
      allTools: `Tout le catalogue (${TOOLS.length} outils)`,
      allProjects: `Les ${t.projects.length} réalisations`,
      contact: 'Contact',
      contactTitle: 'Une question ?',
      contactText:
        'Le formulaire est le plus direct. Mes profils et mes CV sont aussi à portée de clic.',
    }
  : {
      portfolio: 'Portfolio',
      projects: 'Projects',
      profile: 'Profile',
      expertise: 'Areas of expertise',
      career: 'Career, to scale',
      careerMore: 'Full career, duties and education',
      writing: 'What I write',
      blog: 'Blog',
      allPosts: `All ${posts.length} blog posts`,
      building: 'What I build',
      tools: 'Tools and cheatsheets',
      tool: 'Tool',
      cheat: 'Cheatsheet',
      allTools: `Full catalogue (${TOOLS.length} tools)`,
      allProjects: `All ${t.projects.length} projects`,
      contact: 'Contact',
      contactTitle: 'A question?',
      contactText: 'The form is the most direct way. My profiles and résumés are one click away.',
    };
---

<Base
  lang={lang}
  title={t.meta.title}
  description={t.meta.description}
  path={routes.home}
  alternates={routeAlternates('home')}
  ld={homeLd(lang, t.meta.title, t.hero.role)}
>
  <header class="hm-hero">
    <div class="container hm-hero-grid">
      <div class="hm-hero-copy">
        <p class="label led">{labels.portfolio}</p>
        <h1 class="hm-name">
          <span>{firstName}</span>
          <span>{lastName}</span>
        </h1>
        <p class="hm-role">{t.hero.role}</p>
        <p class="hm-pitch">{t.hero.pitch}</p>
        <p class="row hm-actions">
          <a class="btn btn-primary" href={routes.projects}>
            {t.hero.projectsBtn}
            <Icon name="arrow" size={18} />
          </a>
          <a class="btn" href={routes.contact}>
            {t.hero.contactBtn}
          </a>
        </p>
        <SocialLinks lang={lang} cv class="hm-social" />
      </div>
      <AvatarPortrait lang={lang} />
    </div>
  </header>

  <section class="band band-petrole hm-band" aria-labelledby="projects-title">
    <Shape variant="blob" />
    <div class="container hm-band-in">
      <div class="hm-top">
        <div>
          <p class="label">{labels.portfolio}</p>
          <h2 id="projects-title" class="hm-h2">
            {labels.projects}
          </h2>
        </div>
        <span class="hm-bignum" aria-hidden="true">
          01
        </span>
      </div>
      <ul role="list">
        {featured.map((project) => (
          <li class="hm-project">
            <a href={projectPath(lang, project.slug)}>
              <h3>{project.title}</h3>
              <div class="hm-project-text">
                <p class="label">
                  {skillName(project.skill)}
                  {project.kind && <> · {text.project.kinds[project.kind]}</>}
                </p>
                <p>{project.desc}</p>
                <p class="hm-project-tags">{project.tags.join(' · ')}</p>
              </div>
              <ProjectArt slug={project.slug} />
            </a>
          </li>
        ))}
      </ul>
      <p class="hm-band-more">
        <a class="btn" href={routes.projects}>
          {labels.allProjects}
        </a>
      </p>
    </div>
  </section>

  <section aria-labelledby="profile-title">
    <div class="container hm-section">
      <div class="hm-top">
        <div>
          <p class="label">{labels.portfolio}</p>
          <h2 id="profile-title" class="hm-h2">
            {labels.profile}
          </h2>
        </div>
        <span class="hm-bignum" aria-hidden="true">
          02
        </span>
      </div>
      <div class="hm-profile">
        <div>
          <h3 class="hm-h3">{labels.expertise}</h3>
          <ul class="hm-def" role="list">
            {t.skills.map((skill) => (
              <li>
                <a href={`${routes.skills}#${skill.id}`}>
                  <b>{skill.category}</b>
                  <span>{skill.short}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
        <blockquote class="hm-statement">
          <p>{statement.main}</p>
          <p class="hm-statement-sub">{statement.sub}</p>
        </blockquote>
      </div>
      <h3 class="hm-h3 hm-h3-spaced">{labels.career}</h3>
      <CareerTimeline lang={lang} />
      <p class="hm-more">
        <a href={routes.career}>{labels.careerMore}</a>
      </p>
    </div>
  </section>

  <section class="band band-olive" aria-labelledby="reading-title">
    <Shape variant="wave" />
    <div class="container hm-section">
      <div class="hm-top">
        <div>
          <p class="label">{labels.writing}</p>
          <h2 id="reading-title" class="hm-h2">
            {labels.blog}
          </h2>
        </div>
        <span class="hm-bignum" aria-hidden="true">
          03
        </span>
      </div>
      <div class="hm-duo">
        {lead && (
          <article class="hm-lead">
            <p class="label led">
              {CATEGORIES[lead.data.category]?.[lang]} ·{' '}
              <time datetime={isoDate(lead.data.date)}>{longFmt.format(lead.data.date)}</time>
            </p>
            <h3>
              <a href={postPath(lang, lead.slug)}>{lead.data.title}</a>
            </h3>
            <p>{lead.data.summary ?? lead.data.description}</p>
            <p class="hm-more">
              <a href={routes.blog}>{labels.allPosts}</a>
            </p>
          </article>
        )}
        <ul class="ledger-list" role="list">
          {reading.map((post) => (
            <li>
              <a class="ledger-row" href={postPath(lang, post.slug)}>
                <span class="ledger-meta label">
                  <time datetime={isoDate(post.data.date)}>{dayFmt.format(post.data.date)}</time>
                  {' · '}
                  {CATEGORIES[post.data.category]?.[lang]}
                </span>
                <span class="ledger-title">{post.data.title}</span>
                <span class="ledger-arrow" aria-hidden="true">
                  <Icon name="arrow" size={18} />
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section aria-labelledby="tools-title">
    <div class="container hm-section hm-tools">
      <div class="hm-top">
        <div>
          <p class="label">{labels.building}</p>
          <h2 id="tools-title" class="hm-h2">
            {labels.tools}
          </h2>
        </div>
        <span class="hm-bignum" aria-hidden="true">
          04
        </span>
      </div>
      <ul class="ledger-list" role="list">
        {homeTools.map((tool) => (
          <li>
            <a class="ledger-row" href={tool.href}>
              <span class="ledger-meta label led">{labels.tool}</span>
              <span class="ledger-title">
                {tool.name}
                <span class="ledger-sub">{tool.card}</span>
              </span>
              <span class="ledger-arrow" aria-hidden="true">
                <Icon name="arrow" size={18} />
              </span>
            </a>
          </li>
        ))}
        <li>
          <a class="ledger-row" href={withBase(demo.href)}>
            <span class="ledger-meta label">{labels.cheat}</span>
            <span class="ledger-title">
              {demo.title}
              <span class="ledger-sub">{demo.desc}</span>
            </span>
            <span class="ledger-arrow" aria-hidden="true">
              <Icon name="arrow" size={18} />
            </span>
          </a>
        </li>
      </ul>
      <p class="hm-more">
        <a href={routes.tools}>{labels.allTools}</a>
        {cheatsheets && (
          <>
            {' · '}
            <a href={cheatsheets.href}>{`${t.nav.cheatsheets} (${refsFor(lang).length})`}</a>
          </>
        )}
      </p>
      <div class="hm-terminal">
        <Terminal lang={lang} />
      </div>
    </div>
  </section>

  <section class="hm-contact" id="contact" aria-labelledby="contact-title">
    <Shape variant="blob" />
    <div class="container hm-contact-in">
      <p class="label">{labels.contact}</p>
      <h2 id="contact-title" class="hm-cta">
        {labels.contactTitle}
      </h2>
      <p class="hm-contact-text">{labels.contactText}</p>
      <div class="row hm-contact-actions">
        <a class="btn btn-primary" href={routes.contact}>
          {t.hero.contactBtn}
        </a>
        <SocialLinks lang={lang} cv />
      </div>
    </div>
  </section>
</Base>
