---
import Base from '../layouts/Base.astro';
import AvatarPortrait from '../components/AvatarPortrait.astro';
import CareerTimeline from '../components/CareerTimeline.astro';
import Icon from '../components/Icon.astro';
import SocialLinks from '../components/SocialLinks.astro';
import Terminal from '../components/Terminal.astro';
import { PORTFOLIO_DATA, PROFILE } from '../data/content';
import { SITE_TEXT } from '../data/site-text';
import { CATEGORIES, getPosts, isoDate, postPath } from '../lib/blog';
import { withBase } from '../lib/base';
import { ROUTES, projectPath, routeAlternates, type Lang } from '../lib/i18n';
import { homeLd } from '../lib/seo';
import { resourceLinks } from '../lib/sections';
import { ticketOf } from '../lib/ticket';
import { refsFor } from '../reference/refs';
import { TOOL_GROUPS } from '../tools/hub';
import { TOOLS, findTool, toolPath, toolUi } from '../tools/registry';
import '../styles/home.css';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const fr = lang === 'fr';
const t = PORTFOLIO_DATA[lang];
const text = SITE_TEXT[lang];
const routes = ROUTES[lang];
const posts = await getPosts(lang);
const [lead, ...others] = posts;
const reading = others.slice(0, 4);
const demo = text.home.cheatDemo;
const [firstName, ...rest] = PROFILE.name.split(' ');
const lastName = rest.join(' ');
const dayFmt = new Intl.DateTimeFormat(fr ? 'fr-FR' : 'en-GB', {
  day: 'numeric',
  month: 'short',
  timeZone: 'UTC',
});
const longFmt = new Intl.DateTimeFormat(fr ? 'fr-FR' : 'en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});
const skillName = (id: string) => t.skills.find((s) => s.id === id)?.category ?? '';
const cheatsheets = resourceLinks(lang).find((l) => l.key === 'cheatsheets');
// Outils rangés par catégorie, comme dans le menu : un seul groupe par outil (vérifié par tests/unit/tool-groups.test.ts)
const toolGroups = TOOL_GROUPS.map((group) => ({
  id: group.id,
  title: group[lang].title,
  tools: group.tools.flatMap((id) => {
    const tool = findTool(id);
    return tool ? [{ name: toolUi(tool, lang).name, href: toolPath(tool, lang) }] : [];
  }),
}));

// Faits de « En bref » (poste, parcours antérieur) et langues
const facts: [string, string][] = [
  ...(t.aboutFacts.filter((_, i) => i === 0 || i === 3) as [string, string][]),
  [fr ? 'Langues' : 'Languages', t.languagesInfo],
];
const statement = fr
  ? {
      main: "J'ai toujours testé les choses pour comprendre comment elles marchent.",
      sub: "Quand une tâche revient, j'écris l'outil qui la fait à ma place.",
    }
  : {
      main: 'I have always tested things to see how they work.',
      sub: 'When a task keeps coming back, I write the tool that does it for me.',
    };
// Technologies : étiquettes des réalisations, sans doublon (rien n'est saisi à la main)
const technologies = [...new Set(t.projects.flatMap((p) => p.tags))];
const featured = t.projects.slice(0, 4);
const labels = fr
  ? {
      promptLabel: 'Aperçu en ligne de commande : domaines de compétence',
      openTerminal: 'Essayer le terminal',
      about: 'Présentation',
      skills: 'Compétences',
      allSkills: 'Toutes les compétences',
      techs: 'Technologies',
      projects: 'Projets sélectionnés',
      allProjects: `Les ${t.projects.length} réalisations`,
      career: 'Expériences',
      careerMore: 'Parcours détaillé, missions et formation',
      blog: 'Derniers articles',
      allPosts: `Les ${posts.length} articles du blog`,
      tools: 'Outils en ligne',
      allTools: `Le catalogue (${TOOLS.length} outils)`,
      toolsNote: 'Gratuits, sans compte, rien n’est conservé.',
      terminal: 'Terminal',
      terminalMeta: 'tapez help',
      contactTitle: 'Une question, un projet ?',
      contactText:
        'Le formulaire est le plus direct : je lis chaque message et je réponds moi-même. Mes profils et mes CV sont aussi à portée de clic.',
    }
  : {
      promptLabel: 'Command-line preview: areas of expertise',
      openTerminal: 'Try the terminal',
      about: 'About',
      skills: 'Skills',
      allSkills: 'All skills',
      techs: 'Technologies',
      projects: 'Selected projects',
      allProjects: `All ${t.projects.length} projects`,
      career: 'Experience',
      careerMore: 'Full career, duties and education',
      blog: 'Latest articles',
      allPosts: `All ${posts.length} blog posts`,
      tools: 'Online tools',
      allTools: `Full catalogue (${TOOLS.length} tools)`,
      toolsNote: 'Free, no account, nothing you type is kept.',
      terminal: 'Terminal',
      terminalMeta: 'type help',
      contactTitle: 'A question, a project?',
      contactText:
        'The form is the most direct way: I read every message and reply myself. My profiles and résumés are one click away.',
    };
---

<Base
  lang={lang}
  title={t.meta.title}
  description={t.meta.description}
  path={routes.home}
  alternates={routeAlternates('home')}
  ld={homeLd(lang, t.meta.title, t.hero.role)}
>
  <header class="hm-hero">
    <div class="container hm-hero-grid">
      <div class="hm-hero-copy">
        <h1 class="hm-name">
          <span class="hm-first">{firstName}</span> <span class="hm-last">{lastName}</span>
        </h1>
        <p class="hm-role">{t.hero.role}</p>
        <p class="hm-pitch">{t.hero.pitch}</p>
        <p class="hm-actions">
          <a class="btn btn-primary" href={routes.projects}>
            {t.hero.projectsBtn}
          </a>
          <a class="btn" href={routes.blog}>
            {t.nav.blog}
          </a>
          <a class="btn" href={routes.contact}>
            {t.hero.contactBtn}
          </a>
        </p>
        <SocialLinks lang={lang} cv class="hm-social" />
      </div>
      <aside class="hm-prompt" aria-label={labels.promptLabel}>
        <p class="hm-ps">
          <b>guillaume@grichard.eu</b>:~$ ls competences/
        </p>
        <ul role="list">
          {t.skills.map((skill) => (
            <li>
              <a href={`${routes.skills}#${skill.id}`}>
                <span>{skill.id}/</span>
                <span class="hm-dim">{skill.category}</span>
              </a>
            </li>
          ))}
        </ul>
        <p class="hm-ps">
          <b>guillaume@grichard.eu</b>:~$ <span class="hm-caret" aria-hidden="true"></span>
        </p>
        <a class="hm-open" href="#terminal">
          {labels.openTerminal}
        </a>
      </aside>
    </div>
  </header>

  <section class="hm-section" aria-labelledby="about-title">
    <div class="container">
      <div class="rubric">
        <h2 id="about-title">{labels.about}</h2>
        <p class="rubric-meta">
          <a href={routes.about}>{t.nav.about}</a>
        </p>
      </div>
      <div class="hm-about">
        <div class="hm-about-text">
          <blockquote class="hm-statement">
            <p>{statement.main}</p>
            <p class="note">{statement.sub}</p>
          </blockquote>
          <dl class="hm-facts">
            {facts.map(([term, detail]) => (
              <div>
                <dt>{term}</dt>
                <dd>{detail}</dd>
              </div>
            ))}
          </dl>
        </div>
        <AvatarPortrait lang={lang} />
      </div>
    </div>
  </section>

  <section class="hm-section" aria-labelledby="skills-title">
    <div class="container">
      <div class="rubric">
        <h2 id="skills-title">{labels.skills}</h2>
        <p class="rubric-meta">
          <a href={routes.skills}>{labels.allSkills}</a>
        </p>
      </div>
      <ul class="hm-skillgrid" role="list">
        {t.skills.map((skill) => (
          <li>
            <a href={`${routes.skills}#${skill.id}`}>
              <b>{skill.category}</b>
              <span>{skill.short}</span>
            </a>
          </li>
        ))}
      </ul>
      <div class="hm-techs">
        <h3 class="hm-subhead">{labels.techs}</h3>
        <ul class="chip-list" role="list">
          {technologies.map((tech) => (
            <li class="chip">{tech}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="hm-section" aria-labelledby="projects-title">
    <div class="container">
      <div class="rubric">
        <h2 id="projects-title">{labels.projects}</h2>
        <p class="rubric-meta">
          <a href={routes.projects}>{labels.allProjects}</a>
        </p>
      </div>
      <ul class="hm-projects" role="list">
        {featured.map((project) => (
          <li>
            <a class="hm-project" href={projectPath(lang, project.slug)}>
              <span class="hm-project-skill">{skillName(project.skill)}</span>
              <h3>{project.title}</h3>
              <p>{project.desc}</p>
              <span class="hm-project-tags">{project.tags.join(' · ')}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="hm-section" aria-labelledby="career-title">
    <div class="container">
      <div class="rubric">
        <h2 id="career-title">{labels.career}</h2>
        <p class="rubric-meta">
          <a href={routes.career}>{labels.careerMore}</a>
        </p>
      </div>
      <CareerTimeline lang={lang} />
    </div>
  </section>

  <section class="hm-section" aria-labelledby="reading-title">
    <div class="container">
      <div class="rubric">
        <h2 id="reading-title">{labels.blog}</h2>
        <p class="rubric-meta">
          <a href={routes.blog}>{labels.allPosts}</a>
        </p>
      </div>
      <ul class="ledger-list" role="list">
        {[lead, ...reading].flatMap((post) =>
          post
            ? [
                <li>
                  <a class="ledger-row" href={postPath(lang, post.slug)}>
                    <span class="ledger-meta">
                      <time datetime={isoDate(post.data.date)}>
                        {longFmt.format(post.data.date)}
                      </time>
                    </span>
                    <span class="ledger-title">
                      {post.data.title}
                      <span class="ledger-sub">
                        {CATEGORIES[post.data.category]?.[lang]} ·{' '}
                        {ticketOf(post.data.date, post.data.category)}
                      </span>
                    </span>
                    <span class="ledger-arrow" aria-hidden="true">
                      <Icon name="arrow" size={18} />
                    </span>
                  </a>
                </li>,
              ]
            : [],
        )}
      </ul>
    </div>
  </section>

  <section class="hm-section" aria-labelledby="tools-title">
    <div class="container">
      <div class="rubric">
        <h2 id="tools-title">{labels.tools}</h2>
        <p class="rubric-meta">
          <a href={routes.tools}>{labels.allTools}</a>
        </p>
      </div>
      <div class="hm-toolgroups">
        {toolGroups.map((group) => (
          <section class="hm-toolgroup" aria-labelledby={`tg-${group.id}`}>
            <h3 id={`tg-${group.id}`} class="hm-subhead">
              {group.title}
            </h3>
            <ul role="list">
              {group.tools.map((tool) => (
                <li>
                  <a href={tool.href}>{tool.name}</a>
                </li>
              ))}
            </ul>
          </section>
        ))}
        <section class="hm-toolgroup" aria-labelledby="tg-cheatsheets">
          <h3 id="tg-cheatsheets" class="hm-subhead">
            {t.nav.cheatsheets}
          </h3>
          <ul role="list">
            <li>
              <a href={withBase(demo.href)}>{demo.title}</a>
            </li>
            {cheatsheets && (
              <li>
                <a href={cheatsheets.href}>{`${t.nav.cheatsheets} (${refsFor(lang).length})`}</a>
              </li>
            )}
          </ul>
        </section>
      </div>
      <p class="hm-tools-note note">{labels.toolsNote}</p>
    </div>
  </section>

  <section class="hm-section" id="terminal" aria-labelledby="record-title">
    <div class="container">
      <div class="rubric">
        <h2 id="record-title">{labels.terminal}</h2>
        <p class="rubric-meta">{labels.terminalMeta}</p>
      </div>
      <div class="hm-terminal">
        <Terminal lang={lang} />
      </div>
    </div>
  </section>

  <section class="hm-section" id="contact" aria-labelledby="contact-title">
    <div class="container">
      <div class="hm-contact">
        <h2 id="contact-title" class="hm-cta">
          {labels.contactTitle}
        </h2>
        <p class="hm-contact-text">{labels.contactText}</p>
        <div class="hm-contact-actions">
          <a class="btn btn-primary" href={routes.contact}>
            {t.hero.contactBtn}
          </a>
          <SocialLinks lang={lang} cv />
        </div>
      </div>
    </div>
  </section>
</Base>
