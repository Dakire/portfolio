---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import PostCard from '../components/PostCard.astro';
import { PORTFOLIO_DATA } from '../data/content';
import { CATEGORY_RELATED, resolveRelated } from '../data/related';
import {
  CATEGORIES,
  CATEGORY_TEXT,
  categoryPath,
  getPosts,
  isoDate,
  postPath,
  slugify,
  tagPath,
} from '../lib/blog';
import { ROUTES, routeAlternates, SITE, type Alternates, type Lang } from '../lib/i18n';
import { blogLd, breadcrumbLd } from '../lib/seo';

interface Props {
  lang: Lang;
  /** Filtre : une catégorie ou un tag (affiché en titre). */
  category?: string;
  tag?: string;
}
const { lang, category, tag } = Astro.props;
const t = PORTFOLIO_DATA[lang].blog;
const routes = ROUTES[lang];
const all = await getPosts(lang);
const posts = all.filter(
  (p) =>
    (category ? p.data.category === category : true) &&
    (tag ? p.data.tags.some((x) => slugify(x) === tag) : true),
);

const categoryIds = [...new Set(all.map((p) => p.data.category))];
const tagCounts = new Map<string, number>();
for (const p of all) for (const x of p.data.tags) tagCounts.set(x, (tagCounts.get(x) ?? 0) + 1);
const tagNames = [...tagCounts.keys()].sort((a, b) => a.localeCompare(b, lang));

const tagLabel = tag ? tagNames.find((x) => slugify(x) === tag) : undefined;
const heading = category ? CATEGORIES[category]?.[lang] : tagLabel;
const kind = category ? (lang === 'fr' ? 'Catégorie' : 'Category') : 'Tag';
// Une catégorie est un hub thématique indexable (texte d'introduction propre, liens vers les outils) ; un tag reste une page de filtre (noindex).
const categoryText = category ? CATEGORY_TEXT[category]?.[lang] : undefined;
const title = !heading
  ? t.siteName
  : categoryText
    ? categoryText.title
    : `${kind} : ${heading} | ${t.siteName}`;
const path = category
  ? categoryPath(lang, category)
  : tag
    ? tagPath(lang, tagLabel ?? tag)
    : routes.blog;
const furtherLinks = category ? await resolveRelated(lang, CATEGORY_RELATED[category]) : undefined;
const categoryLinks = furtherLinks ? [...furtherLinks.tools, ...furtherLinks.refs] : [];
// Index et catégories ont un équivalent dans l'autre langue (si elle a des articles dans la catégorie) ; les tags, non.
const hasOtherLang = category
  ? (await getPosts(lang === 'fr' ? 'en' : 'fr')).some((p) => p.data.category === category)
  : true;
const alternates: Partial<Alternates> | undefined = category
  ? hasOtherLang
    ? { fr: categoryPath('fr', category), en: categoryPath('en', category) }
    : undefined
  : heading
    ? undefined
    : routeAlternates('blog');
const labels =
  lang === 'fr'
    ? { categories: 'Catégories', tags: 'Tags', allPosts: 'Tous' }
    : { categories: 'Categories', tags: 'Tags', allPosts: 'All' };
// Répartition par rubrique (barre) et registre groupé par mois
const catCount = new Map<string, number>();
for (const p of all) catCount.set(p.data.category, (catCount.get(p.data.category) ?? 0) + 1);
const mixOrder = [...catCount.entries()].sort((a, b) => b[1] - a[1]);
let mixX = 0;
const mix = mixOrder.map(([id, n], i) => {
  const w = (n / all.length) * 100;
  const seg = { id, n, i, x: mixX, w };
  mixX += w;
  return seg;
});
const monthFmt = new Intl.DateTimeFormat(lang === 'fr' ? 'fr-FR' : 'en-GB', {
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});
const months: { key: string; label: string; posts: typeof posts }[] = [];
for (const post of posts) {
  const key = isoDate(post.data.date).slice(0, 7);
  let group = months.find((m) => m.key === key);
  if (!group) {
    group = { key, label: monthFmt.format(post.data.date), posts: [] };
    months.push(group);
  }
  group.posts.push(post);
}
const countLabel = (n: number) =>
  lang === 'fr' ? `${n} article${n > 1 ? 's' : ''}` : `${n} article${n > 1 ? 's' : ''}`;
const toolsTitle = lang === 'fr' ? 'Outils et aide-mémoire liés' : 'Related tools and cheatsheets';
---

<Base
  lang={lang}
  title={title}
  description={categoryText?.description ?? t.pageDescription}
  path={path}
  alternates={alternates}
  noindex={Boolean(tag)}
  ld={
    heading
      ? categoryText && {
          '@context': 'https://schema.org',
          '@graph': [
            {
              '@type': 'CollectionPage',
              '@id': `${SITE}${path}#page`,
              url: `${SITE}${path}`,
              name: categoryText.title,
              description: categoryText.description,
              inLanguage: lang === 'fr' ? 'fr-FR' : 'en',
              isPartOf: { '@id': `${SITE}/#website` },
              mainEntity: {
                '@type': 'ItemList',
                itemListElement: posts.map((p, i) => ({
                  '@type': 'ListItem',
                  position: i + 1,
                  url: `${SITE}${postPath(lang, p.slug)}`,
                  name: p.data.title,
                })),
              },
            },
            breadcrumbLd([
              { name: lang === 'fr' ? 'Accueil' : 'Home', path: routes.home },
              { name: 'Blog', path: routes.blog },
              { name: heading, path },
            ]),
          ],
        }
      : blogLd(
          lang,
          t.siteName,
          posts.map((p) => ({
            title: p.data.title,
            path: postPath(lang, p.slug),
            date: p.data.date,
          })),
        )
  }
>
  <PageHero
    path={heading ? `~/blog/${category ?? tag}` : '~/blog'}
    title={heading ?? t.siteName}
    lead={categoryText?.intro ?? (heading ? undefined : t.pageIntro)}
  />
  <div class="container blog-page">
    <section class="blog-filters" aria-labelledby="blog-filters-title">
      <h2 id="blog-filters-title" class="label">
        {lang === 'fr'
          ? `Répartition des ${all.length} articles`
          : `${all.length} articles by topic`}
      </h2>
      <svg
        class="blog-mix"
        viewBox="0 0 100 12"
        preserveAspectRatio="none"
        aria-hidden="true"
        focusable="false"
      >
        {mix.map((seg) => (
          <a href={categoryPath(lang, seg.id)} tabindex="-1">
            <rect
              class={`mix-${seg.i % 7}`}
              data-on={category === seg.id ? '' : undefined}
              x={seg.x + 0.15}
              y="0"
              width={Math.max(seg.w - 0.3, 0.2)}
              height="12"
            />
          </a>
        ))}
      </svg>
      <nav aria-label={labels.categories}>
        <h2 class="visually-hidden">{labels.categories}</h2>
        <ul class="row" role="list">
          <li>
            <a href={routes.blog} class="chip" aria-current={heading ? undefined : 'page'}>
              {labels.allPosts}
              <span class="chip-count">{all.length}</span>
            </a>
          </li>
          {categoryIds.map((id) => (
            <li>
              <a
                href={categoryPath(lang, id)}
                class="chip"
                aria-current={category === id ? 'page' : undefined}
              >
                {CATEGORIES[id]?.[lang]}
                <span class="chip-count">{catCount.get(id)}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </section>

    {posts.length > 0 ? (
      <div class="ledger">
        {months.map((month) => (
          <section class="ledger-month" aria-labelledby={`m-${month.key}`}>
            <header class="ledger-head">
              <h2 id={`m-${month.key}`}>{month.label}</h2>
              <span class="label">{countLabel(month.posts.length)}</span>
            </header>
            <ul class="cards cards-wide ledger-cards" role="list">
              {month.posts.map((post) => (
                <li>
                  <PostCard post={post} minLabel={t.min} />
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    ) : (
      <p>{t.emptyText}</p>
    )}

    {categoryLinks.length > 0 && (
      <section class="stack" aria-labelledby="category-tools-title">
        <h2 id="category-tools-title">{toolsTitle}</h2>
        <ul role="list">
          {categoryLinks.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="stack" aria-labelledby="tags-title">
      <h2 id="tags-title">{labels.tags}</h2>
      <ul class="row" role="list">
        {tagNames.map((name) => (
          <li>
            <a
              href={tagPath(lang, name)}
              class="chip"
              aria-current={tagLabel === name ? 'page' : undefined}
            >
              {name}
            </a>
          </li>
        ))}
      </ul>
    </section>
    <p>
      <a href={`${SITE}${routes.rss}`}>RSS</a>
    </p>
  </div>
</Base>
