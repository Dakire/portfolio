---
// Page de détail d'une réalisation : résumé, stack, blocs facultatifs (contexte, rôle, déroulé, résultat) et liens vers ce qui s'y rattache.
// Un bloc absent des données n'est pas affiché : aucune section vide, rien d'inventé.
import Button from '@grichard/ui/components/Button.astro';
import CtaBand from '@grichard/ui/components/CtaBand.astro';
import Tag from '@grichard/ui/components/Tag.astro';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ProjectCards from '../components/ProjectCards.astro';
import { PORTFOLIO_DATA, PROFILE, type Project } from '../data/content';
import { PROJECT_RELATED, hasRelated, resolveRelated } from '../data/related';
import { SITE_TEXT } from '../data/site-text';
import { crumbs } from '../lib/crumbs';
import { UI, ROUTES, projectPath, type Lang } from '../lib/i18n';
import { shortDescription } from '../lib/seo';
import { ogImage, projectLd } from '../lib/seo-pages';

interface Props {
  lang: Lang;
  project: Project;
}
const { lang, project } = Astro.props;
const t = PORTFOLIO_DATA[lang];
const text = SITE_TEXT[lang];
const routes = ROUTES[lang];
const path = projectPath(lang, project.slug);
const trail = crumbs(lang, [{ label: t.projectsTitle, path: routes.projects }], {
  label: project.title,
  path,
});
const related = await resolveRelated(lang, PROJECT_RELATED[project.slug]);
const domain = t.skills.find((s) => s.id === project.skill);
const others = t.projects.filter((p) => p.slug !== project.slug).slice(0, 3);
const description = shortDescription(project.desc);
const hasBlocks = Boolean(
  project.context || project.role || project.steps?.length || project.result,
);
---

<Base
  lang={lang}
  title={`${project.title} | ${PROFILE.name}`}
  description={description}
  path={path}
  alternates={{ fr: projectPath('fr', project.slug), en: projectPath('en', project.slug) }}
  image={ogImage(`project-${project.slug}-${lang}`, project.title)}
  ld={projectLd({
    lang,
    path,
    title: project.title,
    description,
    tags: project.tags,
    domain: domain?.category,
    listPath: routes.projects,
    repository: project.href,
    crumbs: trail.ld,
  })}
>
  <PageHero path={project.title} title={project.title} crumbs={trail}>
    <p class="lead">{project.desc}</p>
  </PageHero>
  <div class="container stack-lg section">
    <section class="stack" aria-labelledby="summary">
      <h2 id="summary">{text.project.summary}</h2>
      <dl class="facts">
        <div>
          <dt>{text.project.stack}</dt>
          <dd class="row">
            {project.tags.map((tag) => (
              <Tag>{tag}</Tag>
            ))}
          </dd>
        </div>
        {project.kind && (
          <div>
            <dt>{text.project.kind}</dt>
            <dd>{text.project.kinds[project.kind]}</dd>
          </div>
        )}
        {domain && (
          <div>
            <dt>{text.project.domain}</dt>
            <dd>
              <a href={`${routes.skills}#${domain.id}`}>{domain.category}</a>
            </dd>
          </div>
        )}
        {project.href && (
          <div>
            <dt>GitHub</dt>
            <dd>
              <a href={project.href} rel="noopener">
                {text.project.code}
                <span class="visually-hidden"> {UI[lang].external}</span>
              </a>
            </dd>
          </div>
        )}
      </dl>
    </section>

    {hasBlocks && (
      <>
        {project.context && (
          <section class="stack" aria-labelledby="context">
            <h2 id="context">{text.project.context}</h2>
            <p class="prose">{project.context}</p>
          </section>
        )}
        {project.role && (
          <section class="stack" aria-labelledby="role">
            <h2 id="role">{text.project.role}</h2>
            <p class="prose">{project.role}</p>
          </section>
        )}
        {project.steps && project.steps.length > 0 && (
          <section class="stack" aria-labelledby="steps">
            <h2 id="steps">{text.project.steps}</h2>
            <ol class="points">
              {project.steps.map((step) => (
                <li>{step}</li>
              ))}
            </ol>
          </section>
        )}
        {project.result && (
          <section class="stack" aria-labelledby="result">
            <h2 id="result">{text.project.result}</h2>
            <p class="prose">{project.result}</p>
          </section>
        )}
      </>
    )}

    {hasRelated(related) && (
      <section class="stack" aria-labelledby="proofs">
        <h2 id="proofs">{text.project.proofs}</h2>
        <div class="proofs">
          {related.posts.length > 0 && (
            <div>
              <h3>{text.project.posts}</h3>
              <ul class="link-list">
                {related.posts.map((l) => (
                  <li>
                    <a href={l.href}>{l.label}</a>
                  </li>
                ))}
              </ul>
            </div>
          )}
          {related.tools.length > 0 && (
            <div>
              <h3>{text.project.tools}</h3>
              <ul class="link-list">
                {related.tools.map((l) => (
                  <li>
                    <a href={l.href}>{l.label}</a>
                  </li>
                ))}
              </ul>
            </div>
          )}
          {related.refs.length > 0 && (
            <div>
              <h3>{text.project.cheatsheets}</h3>
              <ul class="link-list">
                {related.refs.map((l) => (
                  <li>
                    <a href={l.href}>{l.label}</a>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </section>
    )}

    <section class="stack" aria-labelledby="others">
      <h2 id="others">{text.project.others}</h2>
      <ProjectCards items={others} lang={lang} level={3} />
      <p>
        <a href={routes.projects}>{t.projectsAll} →</a>
      </p>
    </section>

    <CtaBand title={text.contactBand.title}>
      <p>{text.contactBand.text}</p>
      <Fragment slot="actions">
        <Button variant="primary" href={routes.contact}>
          {t.hero.contactBtn}
        </Button>
      </Fragment>
    </CtaBand>
  </div>
</Base>
