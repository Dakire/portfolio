---
import Base from '../layouts/Base.astro';
import Button from '@grichard/ui/components/Button.astro';
import '../styles/home.css';
import './design.css';
---

<Base
  lang="fr"
  title="Design system"
  description="Page de style du carnet d'interventions (développement seulement)."
  path="/design/"
  noindex
>
  <div class="container section stack-lg">
    <header class="stack">
      <p class="ticket">Développement seulement · ADR 0014</p>
      <h1>Carnet d'interventions</h1>
      <p class="note">Un papier, deux encres, deux familles : tout le reste est un filet.</p>
    </header>

    <section class="stack" aria-labelledby="ds-colors">
      <div class="rubric">
        <h2 id="ds-colors">Couleurs</h2>
        <p class="rubric-meta">basculer le thème en bas de page</p>
      </div>
      <ul class="ds-swatches" role="list">
        <li>
          <span class="ds-chip ds-canvas"></span>
          <p>--canvas</p>
        </li>
        <li>
          <span class="ds-chip ds-surface"></span>
          <p>--surface</p>
        </li>
        <li>
          <span class="ds-chip ds-raised"></span>
          <p>--raised</p>
        </li>
        <li>
          <span class="ds-chip ds-sunk"></span>
          <p>--sunk</p>
        </li>
        <li>
          <span class="ds-chip ds-line"></span>
          <p>--line</p>
        </li>
        <li>
          <span class="ds-chip ds-line-strong"></span>
          <p>--line-strong</p>
        </li>
        <li>
          <span class="ds-chip ds-ink"></span>
          <p>--ink</p>
        </li>
        <li>
          <span class="ds-chip ds-body"></span>
          <p>--body</p>
        </li>
        <li>
          <span class="ds-chip ds-muted"></span>
          <p>--muted</p>
        </li>
        <li>
          <span class="ds-chip ds-accent"></span>
          <p>--accent</p>
        </li>
        <li>
          <span class="ds-chip ds-pen"></span>
          <p>--pen</p>
        </li>
        <li>
          <span class="ds-chip ds-ok"></span>
          <p>--ok</p>
        </li>
        <li>
          <span class="ds-chip ds-warn"></span>
          <p>--warn</p>
        </li>
        <li>
          <span class="ds-chip ds-danger"></span>
          <p>--danger</p>
        </li>
        <li>
          <span class="ds-chip ds-band"></span>
          <p>--band</p>
        </li>
        <li>
          <span class="ds-chip ds-band-ink"></span>
          <p>--band-ink</p>
        </li>
        <li>
          <span class="ds-chip ds-margin-rule"></span>
          <p>--margin-rule</p>
        </li>
      </ul>
    </section>

    <section class="stack ds-type" aria-labelledby="ds-type">
      <div class="rubric">
        <h2 id="ds-type">Typographie</h2>
        <p class="rubric-meta">Newsreader · IBM Plex Mono</p>
      </div>
      <p class="hm-name">
        <span class="hm-first">Guillaume</span>
        <span class="hm-last">Richard</span>
      </p>
      <h1>Titre de page, 650</h1>
      <h2>Titre de rubrique</h2>
      <h3>Titre de section</h3>
      <p>
        Texte courant en Newsreader, 19 px, interligne 1,62.{' '}
        <a href="#ds-type">Un lien en bleu de stylo</a>, souligné. <code>code en mono</code>.
      </p>
      <p class="label">Libellé en mono, sourdine</p>
      <p class="ticket">
        N° <b>20261120-SEC</b> · Sécurité · 20 novembre 2026
      </p>
      <p class="note">Une annotation au stylo bleu, en italique.</p>
      <p>
        <span class="stamp">en cours</span> <span class="stamp stamp-pen">à revoir</span>
      </p>
    </section>

    <section class="stack" aria-labelledby="ds-actions">
      <div class="rubric">
        <h2 id="ds-actions">Actions</h2>
      </div>
      <div class="ds-row">
        <Button variant="primary">Principal</Button>
        <Button>Secondaire</Button>
        <Button variant="ghost">Discret</Button>
        <Button disabled>Désactivé</Button>
        <span class="chip">Puce</span>
        <span class="chip" aria-current="page">
          Puce active
        </span>
        <span class="tag">étiquette</span>
        <kbd class="kbd">Ctrl</kbd>
      </div>
    </section>

    <section class="stack" aria-labelledby="ds-lists">
      <div class="rubric">
        <h2 id="ds-lists">Registre</h2>
      </div>
      <ul class="ledger-list" role="list">
        <li>
          <a class="ledger-row" href="#ds-lists">
            <span class="ledger-meta">GR-R01</span>
            <span class="ledger-title">
              Une ligne de registre<span class="ledger-sub">Sous-titre en sourdine</span>
            </span>
            <span class="ledger-arrow" aria-hidden="true">
              →
            </span>
          </a>
        </li>
        <li>
          <a class="ledger-row" href="#ds-lists">
            <span class="ledger-meta">20261114-SEC</span>
            <span class="ledger-title">
              Une seconde ligne, plus longue pour voir le retour à la ligne sur petit écran
            </span>
            <span class="ledger-arrow" aria-hidden="true">
              →
            </span>
          </a>
        </li>
      </ul>
    </section>

    <section class="stack" aria-labelledby="ds-forms">
      <div class="rubric">
        <h2 id="ds-forms">Champs, alertes, tableau</h2>
      </div>
      <div class="field">
        <label for="ds-name">Nom de domaine</label>
        <input id="ds-name" type="text" value="exemple.fr" />
        <p class="field-hint">Indication en sourdine</p>
      </div>
      <div class="alert alert-ok" role="status">
        <p class="alert-title">Conforme</p>
        <p>Message d'état.</p>
      </div>
      <div class="alert alert-warn" role="status">
        <p class="alert-title">À surveiller</p>
        <p>Message d'avertissement.</p>
      </div>
      <div class="alert alert-danger" role="alert">
        <p class="alert-title">Erreur</p>
        <p>Message d'erreur.</p>
      </div>
      <div class="table-wrap" tabindex="0" role="region" aria-label="Exemple de tableau">
        <table class="table">
          <caption>Exemple</caption>
          <thead>
            <tr>
              <th>Paramètre</th>
              <th>Rôle</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>
                <code>p=none</code>
              </td>
              <td>Surveillance seulement</td>
            </tr>
            <tr>
              <td>
                <code>p=reject</code>
              </td>
              <td>Rejet des messages en échec</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="band stack" aria-labelledby="ds-band">
      <h2 id="ds-band">Bande d'encre</h2>
      <p>
        Les jetons sont redéfinis à l'intérieur : <a href="#ds-band">un lien</a>, un bouton.
      </p>
      <Button variant="primary">Action</Button>
    </section>
  </div>
</Base>
