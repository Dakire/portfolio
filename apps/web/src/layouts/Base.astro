---
import '@grichard/ui/fonts.css';
import { FONT_PRELOAD } from '@grichard/ui/font-preload';
import '@grichard/ui/tokens.css';
import '@grichard/ui/base.css';
import '@grichard/ui/components.css';
import '../styles/site.css';
import SkipLink from '@grichard/ui/components/SkipLink.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SearchDialog from '../components/SearchDialog.astro';
import { ROUTES, SITE, UI, otherLang, type Alternates, type Lang } from '../lib/i18n';
import { BASE, withBase } from '../lib/base';
import { OG_DEFAULT, fitTitle, jsonForScript, versioned } from '../lib/seo';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Chemin canonique de la page (avec « / » final). */
  path: string;
  /** Page équivalente dans chaque langue (hreflang et sélecteur de langue) ; absent : page sans traduction. */
  alternates?: Partial<Alternates>;
  type?: 'website' | 'article';
  image?: { url: string; width: number; height: number; alt: string };
  ld?: object;
  noindex?: boolean;
  /** Scripts autonomes de public/js/ à charger en plus des scripts communs. */
  scripts?: string[];
}
const {
  lang,
  title: rawTitle,
  description,
  path,
  alternates = {},
  type = 'website',
  image = OG_DEFAULT,
  ld,
  noindex: noindexProp = false,
  scripts = [],
} = Astro.props;

// Préproduction (PUBLIC_NOINDEX=1) : aucune page n'est indexable, quoi que demande la page.
const title = fitTitle(rawTitle);
const noindex = noindexProp || import.meta.env.PUBLIC_NOINDEX === '1';
const ui = UI[lang];
const url = `${SITE}${path}`;
const other = otherLang(lang);
const otherHref = alternates[other];
const hreflangs = (['fr', 'en'] as const).filter((l) => alternates[l]);
const feed = {
  title: lang === 'fr' ? 'Blog de Guillaume Richard' : "Guillaume Richard's blog",
  href: `${SITE}${ROUTES[lang].rss}`,
};
const allScripts = [...scripts, '/js/nav.js', '/js/search.js', '/js/consent.js', '/js/egg.js'];
---

<!doctype html>
<html lang={lang} data-base={BASE || undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#101316" />
    <meta name="color-scheme" content="dark light" />
    <link rel="preload" href={FONT_PRELOAD.display} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={FONT_PRELOAD.text} as="font" type="font/woff2" crossorigin />
    <script is:inline src={versioned('/js/theme.js')}></script>
    <link rel="icon" href={withBase('/favicon.ico')} sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <link rel="manifest" href={withBase('/site.webmanifest')} />
    <link rel="canonical" href={url} />
    {hreflangs.map((l) => (
      <link rel="alternate" hreflang={l} href={`${SITE}${alternates[l]}`} />
    ))}
    {alternates.fr && (
      <link rel="alternate" hreflang="x-default" href={`${SITE}${alternates.fr}`} />
    )}
    <link rel="alternate" type="application/rss+xml" title={feed.title} href={feed.href} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Guillaume Richard" />
    <meta
      name="robots"
      content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'}
    />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Guillaume Richard" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:locale" content={ui.ogLocale} />
    {otherHref && <meta property="og:locale:alternate" content={UI[other].ogLocale} />}
    <meta property="og:image" content={image.url} />
    <meta property="og:image:width" content={String(image.width)} />
    <meta property="og:image:height" content={String(image.height)} />
    <meta property="og:image:alt" content={image.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image.url} />
    <meta name="twitter:image:alt" content={image.alt} />
    {ld && <script type="application/ld+json" set:html={jsonForScript(ld)} />}
  </head>
  <body>
    <div class="page-bg" aria-hidden="true">
      <svg class="page-blob page-blob-top" viewBox="0 0 400 400" focusable="false">
        <path d="M318 62c52 40 76 111 52 172s-92 92-158 104-143-4-176-60S-4 164 36 108 126 12 195 8s71 14 123 54Z" />
      </svg>
      <svg class="page-blob page-blob-bottom" viewBox="0 0 400 400" focusable="false">
        <path d="M70 90C140 20 270 10 340 80s60 170 10 230-150 80-225 50S0 160 70 90Z" />
      </svg>
    </div>
    <SkipLink label={ui.skip} />
    <SiteHeader lang={lang} path={path} otherHref={otherHref} />
    <main id="contenu" tabindex="-1">
      <slot />
    </main>
    <SiteFooter lang={lang} />
    <SearchDialog lang={lang} />
    {allScripts.map((src) => (
      <script is:inline defer src={versioned(src)} />
    ))}
  </body>
</html>
