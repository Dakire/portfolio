---
import '@grichard/ui/fonts.css';
import { FONT_PRELOAD } from '@grichard/ui/font-preload';
import '@grichard/ui/tokens.css';
import '@grichard/ui/base.css';
import '@grichard/ui/components.css';
import '@grichard/ui/cursor.css';
import '../styles/site.css';
import SkipLink from '@grichard/ui/components/SkipLink.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SearchDialog from '../components/SearchDialog.astro';
import { ClientRouter } from 'astro:transitions';
import { ROUTES, SITE, UI, otherLang, type Alternates, type Lang } from '../lib/i18n';
import { BASE, withBase } from '../lib/base';
import { OG_DEFAULT, fitTitle, jsonForScript, versioned } from '../lib/seo';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Chemin canonique de la page (avec « / » final). */
  path: string;
  /** Page équivalente dans chaque langue (hreflang et sélecteur de langue) ; absent : page sans traduction. */
  alternates?: Partial<Alternates>;
  type?: 'website' | 'article';
  image?: { url: string; width: number; height: number; alt: string };
  ld?: object;
  noindex?: boolean;
  /** Scripts autonomes de public/js/ à charger en plus des scripts communs. */
  scripts?: string[];
}
const {
  lang,
  title: rawTitle,
  description,
  path,
  alternates = {},
  type = 'website',
  image = OG_DEFAULT,
  ld,
  noindex: noindexProp = false,
  scripts = [],
} = Astro.props;

// Préproduction (PUBLIC_NOINDEX=1) : aucune page n'est indexable, quoi que demande la page.
const title = fitTitle(rawTitle);
const noindex = noindexProp || import.meta.env.PUBLIC_NOINDEX === '1';
const ui = UI[lang];
const url = `${SITE}${path}`;
const other = otherLang(lang);
const otherHref = alternates[other];
const hreflangs = (['fr', 'en'] as const).filter((l) => alternates[l]);
const feed = {
  title: lang === 'fr' ? 'Blog de Guillaume Richard' : "Guillaume Richard's blog",
  href: `${SITE}${ROUTES[lang].rss}`,
};
// Recherche globale (Pagefind, indexée au build) : seules les pages éditoriales indexables entrent dans l'index. Exclues :
// pages non indexables, 404, pages légales, cheatsheets (recherche à part), page de recherche. Type déduit du chemin.
const r = ROUTES[lang];
const rest = (prefix: string) => (path.startsWith(prefix) ? path.slice(prefix.length) : null);
const sub = rest(r.blog);
const searchKind =
  sub === null || sub === ''
    ? path === r.skills
      ? 'skill'
      : path === r.career
        ? 'experience'
        : (rest(r.projects) ?? '') !== ''
          ? 'project'
          : (rest(r.tools) ?? '') !== ''
            ? 'tool'
            : 'page'
    : /^(categorie|category)\//.test(sub)
      ? 'category'
      : sub.startsWith('tag/')
        ? 'tag'
        : 'article';
const excluded = [
  /\/cheatsheets\//,
  /\/(mentions-legales|legal-notice|confidentialite|privacy|accessibilite|accessibility)\//,
  /\/search\//,
];
const searchable = !noindex && path !== '/404.html' && !excluded.some((re) => re.test(path));
const allScripts = [...scripts, '/js/nav.js', '/js/search.js', '/js/consent.js', '/js/egg.js'];
---

<!doctype html>
<html lang={lang} data-theme="light" data-base={BASE || undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#fafaf7" />
    <meta name="color-scheme" content="light dark" />
    <link rel="preload" href={FONT_PRELOAD.mono} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={FONT_PRELOAD.text} as="font" type="font/woff2" crossorigin />
    <script is:inline src={versioned('/js/theme.js')}></script>
    <link rel="icon" href={withBase('/favicon.ico')} sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <link rel="manifest" href={withBase('/site.webmanifest')} />
    <link rel="canonical" href={url} />
    {hreflangs.map((l) => (
      <link rel="alternate" hreflang={l} href={`${SITE}${alternates[l]}`} />
    ))}
    {alternates.fr && (
      <link rel="alternate" hreflang="x-default" href={`${SITE}${alternates.fr}`} />
    )}
    <link rel="alternate" type="application/rss+xml" title={feed.title} href={feed.href} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Guillaume Richard" />
    <meta
      name="robots"
      content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'}
    />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Guillaume Richard" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:locale" content={ui.ogLocale} />
    {otherHref && <meta property="og:locale:alternate" content={UI[other].ogLocale} />}
    <meta property="og:image" content={image.url} />
    <meta property="og:image:width" content={String(image.width)} />
    <meta property="og:image:height" content={String(image.height)} />
    <meta property="og:image:alt" content={image.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image.url} />
    <meta name="twitter:image:alt" content={image.alt} />
    {ld && <script type="application/ld+json" set:html={jsonForScript(ld)} />}
    {/* Navigation sans rechargement : le routeur charge la page suivante et n'en échange que le contenu (head fusionné, body
         remplacé). Le document reste le même, donc le curseur du site ne cède jamais la place au curseur natif entre deux
         pages. « swap » : échange immédiat dans les navigateurs sans View Transitions (Firefox), sans animation de repli. */}
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <SkipLink label={ui.skip} />
    <div class="sheet">
      <div class="sheet-in">
        <SiteHeader lang={lang} path={path} otherHref={otherHref} />
        <main id="contenu" tabindex="-1" data-pagefind-body={searchable ? '' : undefined}>
          {searchable && <meta data-pagefind-filter="type[content]" content={searchKind} />}
          <slot />
        </main>
        <SiteFooter lang={lang} />
      </div>
    </div>
    <SearchDialog lang={lang} />
    {/* data-astro-rerun : sans lui, le routeur ne relancerait pas un script déjà exécuté, et la page suivante resterait sans
         menu, recherche ni bandeau de cookies. Chaque script coupe ses écouteurs globaux avant l'échange (astro:before-swap). */}
    {allScripts.map((src) => (
      <script is:inline defer data-astro-rerun src={versioned(src)} />
    ))}
  </body>
</html>
