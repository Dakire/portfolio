---
// Illustration du hero : un relevé de signal en lignes de crête (une trace par ligne, comme un oscilloscope empilé).
// Calculée au build, de façon déterministe (même dessin à chaque build) : aucun JavaScript, aucune image à télécharger.
// Décorative (aria-hidden) ; apparaît en fondu à l'arrivée (opacité et transformation seules), immobile si l'utilisateur réduit les animations.
const W = 1440;
const H = 560;
const LINES = 22;
const STEP = 8;

// Générateur pseudo-aléatoire à graine fixe (mulberry32)
let seed = 20261015;
const rand = () => {
  seed |= 0;
  seed = (seed + 0x6d2b79f5) | 0;
  let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
  t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
};

const lines = Array.from({ length: LINES }, (_, k) => {
  const base = 150 + k * ((H - 170) / (LINES - 1));
  // Quelques pics par ligne, groupés vers le centre-droit, plus marqués vers le bas
  const peaks = Array.from({ length: 3 + Math.floor(rand() * 3) }, () => ({
    x: W * (0.45 + rand() * 0.42),
    w: 18 + rand() * 46,
    h: (18 + rand() * 70) * (0.35 + k / LINES),
  }));
  const pts: string[] = [];
  for (let x = 0; x <= W; x += STEP) {
    const envelope = Math.exp(-(((x - W * 0.66) / (W * 0.24)) ** 2));
    const noise = Math.sin(x * 0.045 + k) * 2.2 + Math.sin(x * 0.13 + k * 3) * 1.1;
    const lift = peaks.reduce((sum, p) => sum + p.h * Math.exp(-(((x - p.x) / p.w) ** 2)), 0);
    pts.push(`${x},${(base - envelope * (lift + noise * 3) - noise).toFixed(1)}`);
  }
  const stroke = `M${pts.join(' L')}`;
  return { stroke, fill: `${stroke} L${W},${H} L0,${H} Z`, signal: k === 13 };
});
---

<svg
  class="hero-art"
  viewBox={`0 0 ${W} ${H}`}
  preserveAspectRatio="xMidYMax slice"
  aria-hidden="true"
  focusable="false"
>
  {lines.map((line) => (
    <g class={line.signal ? 'art-signal' : undefined}>
      <path class="art-fill" d={line.fill} />
      <path class="art-line" d={line.stroke} />
    </g>
  ))}
</svg>
