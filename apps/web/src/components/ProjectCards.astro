---
// Réalisations en index typographique (ADR 0014) : référence GR-Rxx, titre, description et outils toujours visibles, domaine à droite.
// Toute la ligne est cliquable (lien du titre étiré) ; le lien GitHub reste cliquable au-dessus.
import type { Project } from '../data/content';
import { PORTFOLIO_DATA } from '../data/content';
import Icon from './Icon.astro';
import { UI, projectPath, type Lang } from '../lib/i18n';
import { projectRef } from '../lib/ticket';
import '../styles/pages.css';

interface Props {
  items: Project[];
  lang: Lang;
  /** Nombre maximal de lignes ; toutes par défaut. */
  limit?: number;
  /** Niveau des titres, selon le titre de section qui précède. */
  level?: 2 | 3;
}
const { items, lang, limit, level = 3 } = Astro.props;
const ui = UI[lang];
const all = PORTFOLIO_DATA[lang].projects;
const skills = PORTFOLIO_DATA[lang].skills;
const Heading = `h${level}` as 'h2' | 'h3';
---

<ol class="pindex" role="list">
  {items.slice(0, limit).map((project) => (
    <li class="pindex-row">
      <span class="pindex-ref">{projectRef(all.findIndex((p) => p.slug === project.slug))}</span>
      <div class="pindex-body">
        <Heading class="pindex-title">
          <a class="pindex-link" href={projectPath(lang, project.slug)}>
            {project.title}
          </a>
        </Heading>
        <p>{project.desc}</p>
        <p class="pindex-tags">{project.tags.join(' · ')}</p>
        {project.href && (
          <p>
            <a class="pindex-extra" href={project.href} rel="noopener">
              GitHub<span class="visually-hidden"> {ui.external}</span>
            </a>
          </p>
        )}
      </div>
      <p class="pindex-skill">{skills.find((s) => s.id === project.skill)?.category}</p>
      <span class="pindex-arrow" aria-hidden="true">
        <Icon name="arrow" size={20} />
      </span>
    </li>
  ))}
</ol>
