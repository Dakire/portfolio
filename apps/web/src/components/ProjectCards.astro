---
// Réalisations en lignes de registre : titre, description et outils, flèche ; toute la ligne est cliquable (lien étiré).
import type { Project } from '../data/content';
import Icon from './Icon.astro';
import { UI, projectPath, type Lang } from '../lib/i18n';

interface Props {
  items: Project[];
  lang: Lang;
  /** Nombre maximal de lignes ; toutes par défaut. */
  limit?: number;
  /** Niveau des titres, selon le titre de section qui précède. */
  level?: 2 | 3;
}
const { items, lang, limit, level = 3 } = Astro.props;
const ui = UI[lang];
const Heading = `h${level}` as 'h2' | 'h3';
---

<ul class="lrows" role="list">
  {items.slice(0, limit).map((project) => (
    <li class="lrow">
      <Heading class="lrow-title">
        <a class="lrow-link" href={projectPath(lang, project.slug)}>
          {project.title}
        </a>
      </Heading>
      <div class="lrow-body">
        <p>{project.desc}</p>
        <p class="lrow-tags">{project.tags.join(' · ')}</p>
        {project.href && (
          <p>
            <a class="lrow-extra" href={project.href} rel="noopener">
              GitHub<span class="visually-hidden"> {ui.external}</span>
            </a>
          </p>
        )}
      </div>
      <span class="ledger-arrow" aria-hidden="true">
        <Icon name="arrow" size={18} />
      </span>
    </li>
  ))}
</ul>
