---
// Domaines de compétences en lignes (pas de cartes) : titre à gauche, description à droite.
import type { Portfolio } from '../data/content';
import Icon from './Icon.astro';

interface Props {
  skills: Portfolio['skills'];
  /** Accueil : une ligne par domaine et un lien vers la page Compétences. */
  compact?: { href: string };
}
const { skills, compact } = Astro.props;
---

<ul class="lrows" role="list">
  {skills.map((skill) => (
    <li class:list={['lrow', !compact && 'is-static']}>
      <h3 class="lrow-title">
        {compact ? (
          <a class="lrow-link" href={`${compact.href}#${skill.id}`}>
            {skill.category}
          </a>
        ) : (
          skill.category
        )}
      </h3>
      <div class="lrow-body">
        <p>{compact ? skill.short : skill.items}</p>
      </div>
      {compact && (
        <span class="ledger-arrow" aria-hidden="true">
          <Icon name="arrow" size={18} />
        </span>
      )}
    </li>
  ))}
</ul>
