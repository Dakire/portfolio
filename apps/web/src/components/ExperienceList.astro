---
import type { Experience } from '../data/content';

interface Props {
  items: Experience[];
  /** Niveau des titres de poste, selon le titre de section qui précède. */
  level?: 2 | 3;
  /** Libellé accessible de la liste de compétences. */
  skillsLabel?: string;
  /** Libellé qui précède la liste des missions (elles ne sont pas exhaustives). */
  dutiesLabel?: string;
}
const {
  items,
  level = 3,
  skillsLabel = 'Compétences',
  dutiesLabel = 'Missions, entre autres :',
} = Astro.props;
const Heading = `h${level}` as 'h2' | 'h3';
---

<ol class="jobs">
  {items.map((job) => (
    <li class="job">
      <div class="job-when">
        <p class="job-date">{job.date}</p>
        <p class="job-where">{job.company}</p>
        {job.contract && <p class="job-contract">{job.contract}</p>}
      </div>
      <div class="job-what">
        <Heading>{job.role}</Heading>
        <p class="job-duties">{dutiesLabel}</p>
        <ul class="points">
          {job.points.map((point) => (
            <li>{point}</li>
          ))}
        </ul>
        {job.skills && job.skills.length > 0 && (
          <ul class="row skill-tags" role="list" aria-label={skillsLabel}>
            {job.skills.map((skill) => (
              <li>
                <span class="tag">{skill}</span>
              </li>
            ))}
          </ul>
        )}
      </div>
    </li>
  ))}
</ol>
