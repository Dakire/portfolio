---
import type { Experience } from '../data/content';

interface Props {
  items: Experience[];
}
const { items } = Astro.props;
---

<ol class="timeline">
  {items.map((job) => (
    <li class="stack">
      <h3>{job.role}</h3>
      <p class="meta">
        {job.company} · {job.location} · {job.date}
      </p>
      <p class="prose">{job.desc}</p>
    </li>
  ))}
</ol>
