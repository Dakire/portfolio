---
interface Props {
  /** Conservé pour les appelants ; plus affiché (le fil d'Ariane et le titre suffisent). */
  path?: string;
  title: string;
  lead?: string;
}
const { title, lead } = Astro.props;
---

<header class="page-hero grid-bg">
  <div class="container">
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</header>
