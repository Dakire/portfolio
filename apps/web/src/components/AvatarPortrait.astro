---
// Portrait de l'accueil : l'avatar dessiné sur un disque d'accent, annoté comme une vue technique.
// Les légendes sont décoratives (les domaines sont listés dans le texte de la page) : masquées aux lecteurs d'écran.
import { withBase } from '../lib/base';
import type { Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const fr = lang === 'fr';
const callouts = [
  { x: 61, y: 11, end: false, a: fr ? 'Formation' : 'Training', b: 'IA · M365 · RGPD' },
  { x: 74, y: 52, end: false, a: fr ? 'Messagerie' : 'Email', b: fr ? '& cloud' : '& cloud' },
  { x: 25.5, y: 46, end: true, a: 'Support', b: fr ? 'N1 → N3' : 'L1 → L3' },
  { x: 20.5, y: 28, end: true, a: fr ? 'Sécurité' : 'Security', b: 'IT' },
];
---

<figure class="portrait">
  <div class="portrait-frame">
    <i class="portrait-disc"></i>
    <img
      class="avatar-sombre portrait-img"
      src={withBase('/img/guillaume-sombre.svg')}
      alt={
        fr
          ? 'Avatar dessiné de Guillaume Richard : cheveux bruns, barbe courte'
          : 'Drawn avatar of Guillaume Richard: brown hair, short beard'
      }
      width="300"
      height="300"
      decoding="async"
    />
    <img
      class="avatar-clair portrait-img"
      src={withBase('/img/guillaume-clair.svg')}
      alt={
        fr
          ? 'Avatar dessiné de Guillaume Richard : cheveux bruns, barbe courte'
          : 'Drawn avatar of Guillaume Richard: brown hair, short beard'
      }
      width="300"
      height="300"
      decoding="async"
    />
    <svg class="portrait-notes" viewBox="0 0 100 100" aria-hidden="true" focusable="false">
      <path d="M50 20 57 11H60M67.8 52H72.5M42.6 46H27M34.6 35.6 27 28H22" />
      <circle cx="50" cy="20" r="1.1" />
      <circle cx="67.8" cy="52" r="1.1" />
      <circle cx="42.6" cy="46" r="1.1" />
      <circle cx="34.6" cy="35.6" r="1.1" />
      {callouts.map((c) => (
        <text x={c.x} y={c.y - 1.2} text-anchor={c.end ? 'end' : 'start'}>
          <tspan x={c.x}>{c.a}</tspan>
          <tspan x={c.x} dy="4.4">
            {c.b}
          </tspan>
        </text>
      ))}
    </svg>
  </div>
  <div class="ruler" aria-hidden="true"></div>
  <figcaption class="label" aria-hidden="true">
    <span>Guillaume R.</span>
    <span>{fr ? 'Vue annotée' : 'Annotated view'}</span>
  </figcaption>
</figure>
