---
// Photo d'identité : l'avatar dessiné, tiré sur papier et fixé en haut de la fiche par deux coins photo. Décoratif en soi
// (l'image porte son texte alternatif), sans légende : les domaines sont dans le texte de la page.
// Deux fichiers (T-shirt noir en thème clair, blanc en thème sombre) : celui qui est masqué n'est pas téléchargé.
import { withBase } from '../lib/base';
import type { Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const alt =
  lang === 'fr'
    ? 'Avatar dessiné de Guillaume Richard : cheveux bruns, barbe courte'
    : 'Drawn avatar of Guillaume Richard: brown hair, short beard';
---

<figure class="photo">
  <div class="photo-print">
    <img
      class="avatar-sombre photo-img"
      src={withBase('/img/guillaume-sombre.svg')}
      alt={alt}
      width="300"
      height="300"
      decoding="async"
    />
    <img
      class="avatar-clair photo-img"
      src={withBase('/img/guillaume-clair.svg')}
      alt={alt}
      width="300"
      height="300"
      decoding="async"
    />
  </div>
</figure>
