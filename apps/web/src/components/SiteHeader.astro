---
import Button from '@grichard/ui/components/Button.astro';
import ThemeSwitch from '@grichard/ui/components/ThemeSwitch.astro';
import { ROUTES, UI, type Lang } from '../lib/i18n';
import { inResources } from '../lib/sections';

interface Props {
  lang: Lang;
  /** Chemin de la page courante, pour repérer le lien actif. */
  path: string;
  /** Page équivalente dans l'autre langue ; absent : renvoie vers l'accueil de l'autre langue. */
  otherHref?: string;
}
const { lang, path, otherHref } = Astro.props;
const ui = UI[lang];
const other = lang === 'fr' ? 'en' : 'fr';
const items = ['about', 'career', 'skills', 'projects', 'resources'] as const;
// « Ressources » reste actif sur le blog, les outils et les cheatsheets : ce sont ses sous-pages.
const isCurrent = (key: (typeof items)[number]) => {
  const href = ROUTES[lang][key];
  return key === 'resources' ? inResources(lang, path) : path === href || path.startsWith(href);
};
---

<header class="site-header">
  <div class="container site-header-inner">
    <a href={ROUTES[lang].home} class="site-name" aria-label={`grichard.eu, ${ui.home}`}>
      grichard
      <span aria-hidden="true" class="site-tld">
        .eu
      </span>
    </a>
    <Button
      variant="primary"
      href={ROUTES[lang].contact}
      class="site-cta"
      aria-current={path === ROUTES[lang].contact ? 'page' : undefined}
    >
      {ui.nav.contact}
    </Button>
    <button
      type="button"
      class="nav-toggle"
      aria-expanded="false"
      aria-controls="site-menu"
      data-nav-toggle
    >
      <span class="nav-toggle-icon" aria-hidden="true"></span>
      {ui.menu}
    </button>
    <div id="site-menu" class="site-menu">
      <nav aria-label={ui.mainNav} class="site-nav">
        <ul>
          {items.map((key) => (
            <li>
              <a
                href={ROUTES[lang][key]}
                aria-current={
                  isCurrent(key) ? (path === ROUTES[lang][key] ? 'page' : 'true') : undefined
                }
              >
                {ui.nav[key]}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <div class="site-tools">
        <a href={otherHref ?? ROUTES[other].home} hreflang={other} lang={other} class="lang-link">
          {ui.langName}
        </a>
        <ThemeSwitch label={ui.theme} labels={ui.themeLabels} />
      </div>
    </div>
  </div>
</header>
