---
import Button from '@grichard/ui/components/Button.astro';
import ThemeSwitch from '@grichard/ui/components/ThemeSwitch.astro';
import { ROUTES, UI, type Lang } from '../lib/i18n';
import { resourceLinks } from '../lib/sections';
import { TOOL_GROUPS } from '../tools/hub';
import { findTool, toolPath, toolUi } from '../tools/registry';

interface Props {
  lang: Lang;
  /** Chemin de la page courante, pour repérer le lien actif. */
  path: string;
  /** Page équivalente dans l'autre langue ; absent : renvoie vers l'accueil de l'autre langue. */
  otherHref?: string;
}
const { lang, path, otherHref } = Astro.props;
const ui = UI[lang];
const other = lang === 'fr' ? 'en' : 'fr';
// Menu à plat : le profil d'abord, puis ce qu'on vient consulter (blog, outils, cheatsheets). Les cheatsheets n'existent qu'en
// français pour l'instant : sans référence dans la langue, l'entrée disparaît.
const cheatsheets = resourceLinks(lang).find((link) => link.key === 'cheatsheets');
const items: { key: keyof (typeof ui)['nav']; href: string }[] = [
  { key: 'about', href: ROUTES[lang].about },
  { key: 'career', href: ROUTES[lang].career },
  { key: 'skills', href: ROUTES[lang].skills },
  { key: 'projects', href: ROUTES[lang].projects },
  { key: 'blog', href: ROUTES[lang].blog },
  { key: 'tools', href: ROUTES[lang].tools },
  ...(cheatsheets ? [{ key: 'cheatsheets' as const, href: cheatsheets.href }] : []),
];
const current = (href: string) =>
  path === href ? ('page' as const) : path.startsWith(href) ? ('true' as const) : undefined;
// Menu « Outils » au survol et au focus : accès direct à chaque outil, rangé par catégorie (le lien du menu reste la page Outils).
const groups = TOOL_GROUPS.map((group) => ({
  title: group[lang].title,
  tools: group.tools.flatMap((id) => {
    const tool = findTool(id);
    return tool ? [{ label: toolUi(tool, lang).name, href: toolPath(tool, lang) }] : [];
  }),
}));
---

<header class="site-header">
  <div class="container site-header-inner">
    <a href={ROUTES[lang].home} class="site-name" aria-label={`grichard.eu, ${ui.home}`}>
      grichard
      <span aria-hidden="true" class="site-tld">
        .eu
      </span>
    </a>
    <Button
      variant="primary"
      href={ROUTES[lang].contact}
      class="site-cta"
      aria-current={path === ROUTES[lang].contact ? 'page' : undefined}
    >
      {ui.nav.contact}
    </Button>
    <button
      type="button"
      class="nav-toggle"
      aria-expanded="false"
      aria-controls="site-menu"
      data-nav-toggle
    >
      <span class="nav-toggle-icon" aria-hidden="true"></span>
      {ui.menu}
    </button>
    <div id="site-menu" class="site-menu">
      <nav aria-label={ui.mainNav} class="site-nav">
        <ul>
          {items.map((item) => (
            <li class={item.key === 'tools' ? 'has-sub' : undefined}>
              <a href={item.href} aria-current={current(item.href)}>
                {ui.nav[item.key]}
              </a>
              {item.key === 'tools' && (
                <div class="subnav">
                  <div class="subnav-groups">
                    {groups.map((group) => (
                      <div>
                        <p class="subnav-title">{group.title}</p>
                        <ul>
                          {group.tools.map((tool) => (
                            <li>
                              <a href={tool.href}>{tool.label}</a>
                            </li>
                          ))}
                        </ul>
                      </div>
                    ))}
                  </div>
                </div>
              )}
            </li>
          ))}
        </ul>
      </nav>
      <div class="site-tools">
        <a href={otherHref ?? ROUTES[other].home} hreflang={other} lang={other} class="lang-link">
          {ui.langName}
        </a>
        <ThemeSwitch label={ui.theme} labels={ui.themeLabels} />
      </div>
    </div>
  </div>
</header>
