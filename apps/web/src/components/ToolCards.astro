---
// Outils du registre en lignes de registre : référence de bon de travail (BT-01…), nom, description, flèche ; toute la ligne
// est cliquable (lien étiré). Page « Outils » (titres h2 ou h3 selon le contexte).
import type { Lang } from '../lib/i18n';
import Icon from './Icon.astro';
import { TOOLS, toolPath, toolUi } from '../tools/registry';

interface Props {
  lang: Lang;
  headingLevel?: 2 | 3;
  /** Nombre maximal de lignes ; toutes par défaut. */
  limit?: number;
  /** Identifiants des outils à afficher, dans cet ordre (une catégorie de la page « Outils ») ; tous par défaut. */
  ids?: readonly string[];
}
const { lang, headingLevel = 2, limit, ids } = Astro.props;
const tools = ids ? ids.flatMap((id) => TOOLS.filter((t) => t.id === id)) : [...TOOLS];
const Heading = headingLevel === 2 ? 'h2' : 'h3';
const ref = (id: string) =>
  `BT-${String(TOOLS.findIndex((t) => t.id === id) + 1).padStart(2, '0')}`;
---

<ul class="tool-rows" role="list">
  {tools.slice(0, limit).map((tool) => {
    const ui = toolUi(tool, lang);
    return (
      <li class="tool-row">
        <span class="tool-row-ref" aria-hidden="true">
          {ref(tool.id)}
        </span>
        <Heading class="tool-row-title">
          <a class="tool-row-link" href={toolPath(tool, lang)}>
            {ui.name}
          </a>
        </Heading>
        <p class="tool-row-text">{ui.card}</p>
        <span class="tool-row-arrow" aria-hidden="true">
          <Icon name="arrow" size={18} />
        </span>
      </li>
    );
  })}
</ul>
