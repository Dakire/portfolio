---
// Outils du registre en lignes : nom, description, flèche ; toute la ligne est cliquable (lien étiré).
// Page « Outils » (titres h2 ou h3 selon le contexte).
import type { Lang } from '../lib/i18n';
import Icon from './Icon.astro';
import { TOOLS, toolPath, toolUi } from '../tools/registry';

interface Props {
  lang: Lang;
  headingLevel?: 2 | 3;
  /** Nombre maximal de lignes ; toutes par défaut. */
  limit?: number;
  /** Identifiants des outils à afficher, dans cet ordre (une catégorie de la page « Outils ») ; tous par défaut. */
  ids?: readonly string[];
}
const { lang, headingLevel = 2, limit, ids } = Astro.props;
const tools = ids ? ids.flatMap((id) => TOOLS.filter((t) => t.id === id)) : [...TOOLS];
const Heading = headingLevel === 2 ? 'h2' : 'h3';
---

<ul class="lrows" role="list">
  {tools.slice(0, limit).map((tool) => {
    const ui = toolUi(tool, lang);
    return (
      <li class="lrow">
        <Heading class="lrow-title">
          <a class="lrow-link" href={toolPath(tool, lang)}>
            {ui.name}
          </a>
        </Heading>
        <div class="lrow-body">
          <p>{ui.card}</p>
        </div>
        <span class="ledger-arrow" aria-hidden="true">
          <Icon name="arrow" size={18} />
        </span>
      </li>
    );
  })}
</ul>
