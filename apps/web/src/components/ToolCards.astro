---
// Cartes des outils, tirées du registre : page « Outils » (titres h2) et accueil (titres h3).
import Card from '@grichard/ui/components/Card.astro';
import type { Lang } from '../lib/i18n';
import { HUB } from '../tools/hub';
import { TOOL_ICONS } from '../tools/icons';
import { TOOLS, toolPath, toolUi } from '../tools/registry';

interface Props {
  lang: Lang;
  headingLevel?: 2 | 3;
  /** Nombre maximal de cartes (aperçu de l'accueil) ; toutes par défaut. */
  limit?: number;
  /** Identifiants des outils à afficher, dans cet ordre (une catégorie de la page « Outils ») ; tous par défaut. */
  ids?: readonly string[];
}
const { lang, headingLevel = 2, limit, ids } = Astro.props;
const tools = ids ? ids.flatMap((id) => TOOLS.filter((t) => t.id === id)) : [...TOOLS];
const hub = HUB[lang];
const Heading = headingLevel === 2 ? 'h2' : 'h3';
---

<ul class="cards" role="list">
  {tools.slice(0, limit).map((tool) => {
    const ui = toolUi(tool, lang);
    const Icon = TOOL_ICONS[tool.icon];
    return (
      <li>
        <Card href={toolPath(tool, lang)} class="tool-card">
          <Icon size={28} class="tool-card-icon" aria-hidden="true" />
          <Heading>{ui.name}</Heading>
          <p>{ui.card}</p>
          <p class="meta">{hub.open} →</p>
        </Card>
      </li>
    );
  })}
</ul>
