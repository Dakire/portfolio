---
// Entrée de blog en fiche : ticket, titre, description. Utilisée hors du blog (page Ressources) ; le blog lui-même liste
// ses articles en lignes de registre (views/BlogIndex.astro).
import Tag from '@grichard/ui/components/Tag.astro';
import { CATEGORIES, formatDate, isoDate, postPath, readingMinutes, type Post } from '../lib/blog';
import { ticketOf } from '../lib/ticket';
import '../styles/blog.css';

interface Props {
  post: Post;
  minLabel: string;
}
const { post, minLabel } = Astro.props;
---

<article class="post-card">
  <p class="ticket">
    <b>{ticketOf(post.data.date, post.data.category)}</b>
  </p>
  <h3>
    <a href={postPath(post.lang, post.slug)}>{post.data.title}</a>
  </h3>
  <p class="post-card-text">{post.data.description}</p>
  <p class="meta post-meta">
    <Tag>{CATEGORIES[post.data.category]?.[post.lang]}</Tag>
    <span>
      <time datetime={isoDate(post.data.date)}>{formatDate(post.data.date, post.lang)}</time>
      {` · ${readingMinutes(post.body)} ${minLabel}`}
    </span>
  </p>
</article>
