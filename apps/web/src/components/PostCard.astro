---
import Card from '@grichard/ui/components/Card.astro';
import Tag from '@grichard/ui/components/Tag.astro';
import { CATEGORIES, formatDate, isoDate, postPath, readingMinutes, type Post } from '../lib/blog';

interface Props {
  post: Post;
  minLabel: string;
}
const { post, minLabel } = Astro.props;
---

<Card href={postPath(post.lang, post.slug)} class="card-post">
  <p class="meta post-meta">
    <Tag>{CATEGORIES[post.data.category]?.[post.lang]}</Tag>
    <span>
      <time datetime={isoDate(post.data.date)}>{formatDate(post.data.date, post.lang)}</time>
      {` · ${readingMinutes(post.body)} ${minLabel}`}
    </span>
  </p>
  <h3>{post.data.title}</h3>
  <p class="card-post-text">{post.data.description}</p>
  <span class="label more-link card-post-cta">
    {post.lang === 'fr' ? 'Lire l’article' : 'Read the article'}
    <span class="arrow" aria-hidden="true">
      →
    </span>
  </span>
</Card>
