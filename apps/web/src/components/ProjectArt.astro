    <circle cx="108" cy="18" r="8" />
    <circle cx="108" cy="50" r="8" />
    <circle cx="108" cy="82" r="8" />
    <path d="M120 50h30" stroke-dasharray="4 4" />
  </svg>
)}
{slug === 'deploiement-windows-server' && (
  <svg class="project-art" viewBox="0 0 160 100" aria-hidden="true" focusable="false">
    <rect x="52" y="6" width="56" height="26" />
