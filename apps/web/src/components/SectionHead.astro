---
// En-tête de section : double filet d'encre, titre en serif et lien « tout voir » facultatif, en mono, à droite.
// Le sur-titre éventuel est du texte décoratif répété par le titre : il est masqué aux lecteurs d'écran.
interface Props {
  id: string;
  /** Mention courte en mono, à droite du titre (ex. « 12 fiches »). */
  eyebrow?: string;
  /** Titre. */
  title: string;
  more?: { href: string; label: string };
}
const { id, eyebrow, title, more } = Astro.props;
---

<div class="section-head">
  <div class="rubric">
    <h2 id={id}>{title}</h2>
    {more ? (
      <p class="rubric-meta">
        <a href={more.href}>{more.label} →</a>
      </p>
    ) : (
      eyebrow && (
        <p class="rubric-meta" aria-hidden="true">
          {eyebrow}
        </p>
      )
    )}
  </div>
</div>
<slot />
