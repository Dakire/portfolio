---
import ToolPage from '../../../views/ToolPage.astro';
import { TOOLS } from '../../../tools/registry';

export function getStaticPaths() {
  return TOOLS.map((tool) => ({ params: { tool: tool.slug.en }, props: { toolId: tool.id } }));
}
const { toolId } = Astro.props;
---

<ToolPage lang="en" toolId={toolId} />
