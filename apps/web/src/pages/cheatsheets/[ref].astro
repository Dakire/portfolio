---
import ReferencePage from '../../views/ReferencePage.astro';
import { refsFor } from '../../reference/refs';

export function getStaticPaths() {
  return refsFor('fr').map((reference) => ({
    params: { ref: reference.id },
    props: { reference },
  }));
}
const { reference } = Astro.props;
---

<ReferencePage lang="fr" reference={reference} />
