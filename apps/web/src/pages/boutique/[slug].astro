---
import ShopProduct from '../../views/ShopProduct.astro';
import { PRODUCTS } from '../../shop/products';

export function getStaticPaths() {
  return PRODUCTS.fr.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}
const { product } = Astro.props;
---

<ShopProduct lang="fr" product={product} />
