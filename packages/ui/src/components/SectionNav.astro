---
interface Item {
  label: string;
  href: string;
  /** « page » : la page affichée ; « true » : la section dont la page affichée fait partie. */
  current?: 'page' | 'true';
}
interface Props {
  items: Item[];
  /** Nom du repère de navigation (ex. « Ressources »). */
  label: string;
}
const { items, label } = Astro.props;
---

<nav aria-label={label} class="section-nav">
  <ul>
    {items.map((item) => (
      <li>
        <a href={item.href} aria-current={item.current}>
          {item.label}
        </a>
      </li>
    ))}
  </ul>
</nav>
