---
interface Props {
  /** Si href est fourni, le composant produit un lien ; sinon un bouton. */
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
  class?: string;
}
const {
  href,
  variant = 'secondary',
  type = 'button',
  disabled = false,
  class: extra = '',
  ...rest
} = Astro.props;
const classes = [
  'btn',
  variant === 'primary' && 'btn-primary',
  variant === 'ghost' && 'btn-ghost',
  extra,
]
  .filter(Boolean)
  .join(' ');
---

{href ? (
  <a href={href} class={classes} {...rest}>
    <slot />
  </a>
) : (
  <button type={type} class={classes} disabled={disabled} {...rest}>
    <slot />
  </button>
)}
